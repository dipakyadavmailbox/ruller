# Microsoft Translator API Credentials (BUILD-TIME ONLY)
# Used by scripts/translate-site.mjs to generate static JSON translations.
# Never expose these credentials with PUBLIC_ or commit real keys to Git.

MICROSOFT_TRANSLATOR_KEY=your_azure_translator_key_here
MICROSOFT_TRANSLATOR_REGION=global
# MICROSOFT_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
