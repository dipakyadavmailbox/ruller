---
import { SITE_CONFIG } from '../../siteConfig.js'

interface Props {
  items: { label: string; path?: string }[]
}
const { items } = Astro.props

const currentUrl = `${SITE_CONFIG.domain}${Astro.url.pathname.replace(/\/$/, '')}`

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.path ? `${SITE_CONFIG.domain}${item.path}` : currentUrl,
  })),
}
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      {item.path ? <a href={item.path}>{item.label}</a> : <span class="current">{item.label}</span>}
    </>
  ))}
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .breadcrumb {
    font-size: 11.5px;
    color: var(--ink-faint);
    padding: 12px 24px 0;
    max-width: 860px;
    margin: 0 auto;
  }
  .breadcrumb a {
    color: var(--ink-faint);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--ink-dim);
  }
  .breadcrumb .current {
    color: var(--ink-dim);
  }
  .breadcrumb .sep {
    margin: 0 6px;
  }
</style>
