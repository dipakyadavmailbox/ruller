---
/**
 * Footer.astro — sitewide footer.
 *
 * Column headings and legal links come from the UI dictionary. The popular
 * long-tail links stay in English on purpose: those destination pages are
 * English-only, so translating the anchor text would promise a translation
 * that does not exist.
 *
 * The legal pages (privacy, terms, DMCA, accessibility) are linked without
 * a locale prefix and are reachable from every page in every language.
 * AdSense review requires them to be reachable and crawlable, so they must
 * never be dropped from this footer.
 */
import { SITE_CONFIG } from '../../siteConfig.js'
import { CATEGORIES } from '../../data/tools.js'
import { DEFAULT_LOCALE } from '../../i18n/config.js'
import { localizePath } from '../../i18n/routing.js'
import { categoryLabel, toolLabel } from '../../i18n/toolKeys.js'
import { t } from '../../i18n/ui.js'
import { formatDate } from '../../i18n/format.js'

interface Props {
  lang?: string
}

const { lang = DEFAULT_LOCALE } = Astro.props
const href = (target) => localizePath(target, lang)

const POPULAR_PRESETS = [
  { label: 'Passport Photo Resizer', slug: '/image-resizer/passport-photo' },
  { label: 'Merge PDF Online', slug: '/pdf-tools/merge-pdf' },
  { label: 'Split PDF Pages', slug: '/pdf-tools/split-pdf' },
  { label: 'JSON to CSV Converter', slug: '/data-converter/json-to-csv' },
  { label: 'Base64 Encoder / Decoder', slug: '/data-converter/base64-encode' },
  { label: 'Password Generator', slug: '/password-checker/password-generator' },
  { label: 'Email Regex Validator', slug: '/regex-tester/email-regex' },
  { label: 'Cron Expression Schedule', slug: '/cron-expression-builder/every-5-minutes' },
  { label: '300 DPI Print Sizing', slug: '/dpi-calculator/300-dpi' },
  { label: 'Wi-Fi QR Code Maker', slug: '/qr-code-generator/wifi' },
]

const POPULAR_CONVERSIONS_HEALTH = [
  { label: 'All 98+ Unit Conversions', slug: '/conversions' },
  { label: 'Kilograms to Pounds (kg to lbs)', slug: '/kg-to-lbs' },
  { label: 'Centimeters to Inches (cm to in)', slug: '/cm-to-inches' },
  { label: 'Celsius to Fahrenheit (C to F)', slug: '/celsius-to-fahrenheit' },
  { label: 'Grams to Ounces (g to oz)', slug: '/g-to-oz' },
  { label: 'Meters to Feet (m to ft)', slug: '/meters-to-feet' },
  { label: 'BMR & TDEE Calculator', slug: '/bmr-calculator' },
  { label: 'Calorie Deficit Calculator', slug: '/calorie-deficit-calculator' },
  { label: 'Pregnancy Due Date Calculator', slug: '/due-date-calculator' },
  { label: 'Ovulation & Fertility Window', slug: '/ovulation-calculator' },
]

const HUB_BADGES = [
  { slug: '/conversions', icon: '🔄', label: 'Conversions' },
  { slug: '/pdf-tools', icon: '📄', key: 'tool.pdf' },
  { slug: '/image-resizer', icon: '🖼️', key: 'tool.imageResizer' },
  { slug: '/data-converter', icon: '📊', key: 'tool.dataConverter' },
  { slug: '/password-checker', icon: '🔒', key: 'tool.password' },
  { slug: '/regex-tester', icon: '⚡', key: 'tool.regex' },
  { slug: '/cron-expression-builder', icon: '🕐', key: 'tool.cron' },
  { slug: '/dpi-calculator', icon: '🖨️', key: 'tool.dpi' },
  { slug: '/ruler', icon: '📏', key: 'tool.ruler' },
  { slug: '/color-tools', icon: '🎨', key: 'tool.colorTools' },
  { slug: '/qr-code-generator', icon: '📱', key: 'tool.qr' },
  { slug: '/calorie-calculator', icon: '🥗', key: 'tool.calorie' },
  { slug: '/pregnancy-calculator', icon: '👶', key: 'tool.pregnancy' },
]

// Rendered with the calendar formatting of the locale rather than a bare
// four-digit year, which keeps the footer consistent with every other date
// on the site.
const currentYear = formatDate(new Date(), lang, { year: 'numeric' })
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <div class="footer-logo">
        <span class="logo-spark">✨</span>
        <span class="logo-title">Rocking Tools</span>
      </div>
      <p class="footer-tagline">{t(lang, 'footer.tagline')}</p>
      <div class="privacy-badge">🔒 {t(lang, 'footer.privacyBadge')}</div>

      <div class="footer-hubs-block">
        <span class="hubs-title">{t(lang, 'footer.toolSuites')}:</span>
        <div class="hubs-badges">
          {HUB_BADGES.map((hub) => (
            <a href={href(hub.slug)}>{hub.icon} {hub.key ? t(lang, hub.key) : hub.label}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-nav-grid">
      <div class="footer-col">
        <div class="col-title">{t(lang, 'footer.popularTools')}</div>
        <ul class="col-list">
          {POPULAR_PRESETS.map((item) => (
            <li><a href={item.slug} hreflang="en">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <div class="col-title">{t(lang, 'footer.conversions')}</div>
        <ul class="col-list">
          {POPULAR_CONVERSIONS_HEALTH.map((item) => (
            <li><a href={item.slug} hreflang="en">{item.label}</a></li>
          ))}
        </ul>
      </div>

      {CATEGORIES.slice(0, 2).map((cat) => (
        <div class="footer-col">
          <div class="col-title">{categoryLabel(cat.heading, lang)}</div>
          <ul class="col-list">
            {cat.tools.map((tool) => (
              <li><a href={href(tool.slug)}>{toolLabel(tool.slug, tool.navLabel, lang)}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer-col">
        <div class="col-title">{t(lang, 'footer.platformLegal')}</div>
        <ul class="col-list">
          <li><a href={href('/about')}>{t(lang, 'footer.aboutUs')}</a></li>
          <li><a href={href('/faq')}>{t(lang, 'nav.faq')}</a></li>
          <li><a href="/sitemap" hreflang="en">{t(lang, 'footer.sitemap')}</a></li>
          <li><a href="/contact" hreflang="en">{t(lang, 'footer.contactSupport')}</a></li>
          <li><a href="/privacy" hreflang="en">{t(lang, 'footer.privacy')}</a></li>
          <li><a href="/terms" hreflang="en">{t(lang, 'footer.terms')}</a></li>
          <li><a href="/accessibility" hreflang="en">{t(lang, 'footer.accessibility')}</a></li>
          <li><a href="/dmca" hreflang="en">{t(lang, 'footer.dmca')}</a></li>
          <li>
            <button id="cookie-settings" class="cookie-settings-btn" type="button" hidden>
              {t(lang, 'footer.cookieSettings')}
            </button>
          </li>
          <li><a href="/donate" hreflang="en">💛 {t(lang, 'nav.support')}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div>© {currentYear} {SITE_CONFIG.siteName}. {t(lang, 'footer.rights')}</div>
    <div class="footer-bottom-links">
      <span>{t(lang, 'footer.englishOnly')}</span>
      <span>•</span>
      <a href="/sitemap">{t(lang, 'footer.directory')}</a>
      <span>•</span>
      <a href="/sitemap-index.xml">{t(lang, 'footer.xmlIndex')}</a>
    </div>
  </div>
</footer>

<script is:inline>
  // Re-opens the consent message so visitors can change or withdraw their
  // choice, which GDPR requires to be as easy as giving it. googlefc is
  // published by the certified Google CMP; until that CMP is enabled in the
  // AdSense console there is nothing to open, so the control stays hidden.
  ;(function () {
    var btn = document.getElementById('cookie-settings')
    if (!btn) return

    window.googlefc = window.googlefc || {}
    window.googlefc.callbackQueue = window.googlefc.callbackQueue || []

    // The CMP loads asynchronously, so reveal the control from its callback
    // rather than testing for it once at parse time.
    window.googlefc.callbackQueue.push({
      CONSENT_DATA_READY: function () {
        btn.hidden = false
      },
    })

    btn.addEventListener('click', function () {
      if (window.googlefc && window.googlefc.showRevocationMessage) {
        window.googlefc.showRevocationMessage()
      } else {
        btn.hidden = true
      }
    })
  })()
</script>

<style>
  .cookie-settings-btn {
    border: none;
    background: transparent;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }
  .cookie-settings-btn[hidden] {
    display: none;
  }
</style>

<style>
  .site-footer {
    border-top: 1px solid var(--panel-border);
    background: var(--panel-bg);
    backdrop-filter: var(--glass-backdrop);
    margin-top: 80px;
    padding: 60px 32px 32px;
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 2.9fr;
    gap: 48px;
  }
  @media (max-width: 1024px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .footer-tagline {
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.6;
    margin: 0;
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    width: fit-content;
  }
  .footer-hubs-block {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .hubs-title {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--accent);
  }
  .hubs-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hubs-badges a {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--panel-border);
    padding: 3px 8px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 150ms ease;
  }
  .hubs-badges a:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 28px;
  }
  .col-title {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .col-list a {
    font-size: 12.5px;
    color: var(--ink-dim);
    font-weight: 500;
    transition: color 150ms ease;
    text-decoration: none;
    line-height: 1.4;
  }
  .col-list a:hover {
    color: var(--ink);
  }
  .footer-bottom {
    max-width: 1200px;
    margin: 48px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--panel-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-bottom-links a {
    color: var(--ink-dim);
    transition: color 150ms ease;
  }
  .footer-bottom-links a:hover {
    color: var(--ink);
  }
</style>
