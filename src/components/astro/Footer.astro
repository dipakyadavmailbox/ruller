---
import { SITE_CONFIG } from '../../siteConfig.js'
import { CATEGORIES } from '../../data/tools.js'
import { useTranslations, getLangFromUrl, getLocalePath } from '../../i18n/ui.js'

const currentLang = getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <div class="footer-logo">
        <span class="logo-spark">✨</span>
        <span class="logo-title">Rocking Tools</span>
      </div>
      <p class="footer-tagline">
        {t('footer.tagline')}
      </p>
      <div class="privacy-badge">
        {t('footer.privacyBadge')}
      </div>
    </div>

    <div class="footer-nav-grid">
      {CATEGORIES.map((cat) => (
        <div class="footer-col">
          <div class="col-title">{cat.heading}</div>
          <ul class="col-list">
            {cat.tools.map((tool) => (
              <li><a href={getLocalePath(tool.slug, currentLang)}>{tool.navLabel}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer-col">
        <div class="col-title">{t('footer.legal')}</div>
        <ul class="col-list">
          <li><a href={getLocalePath('/about', currentLang)}>{t('footer.about')}</a></li>
          <li><a href={getLocalePath('/faq', currentLang)}>{t('footer.faq')}</a></li>
          <li><a href={getLocalePath('/contact', currentLang)}>{t('footer.contact')}</a></li>
          <li><a href={getLocalePath('/privacy', currentLang)}>{t('footer.privacy')}</a></li>
          <li><a href={getLocalePath('/terms', currentLang)}>{t('footer.terms')}</a></li>
          <li><a href={getLocalePath('/accessibility', currentLang)}>Accessibility</a></li>
          <li><a href={getLocalePath('/dmca', currentLang)}>DMCA</a></li>
          <li><a href={getLocalePath('/donate', currentLang)}>{t('nav.support')}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div>© {new Date().getFullYear()} {SITE_CONFIG.siteName}. All rights reserved.</div>
    <div class="footer-bottom-links">
      <span>Built with Astro & React</span>
      <span>•</span>
      <a href={getLocalePath('/sitemap', currentLang)}>{t('footer.sitemap')}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--panel-border);
    background: var(--panel-bg);
    backdrop-filter: var(--glass-backdrop);
    margin-top: 80px;
    padding: 60px 32px 32px;
  }
  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
  }
  @media (max-width: 860px) {
    .footer-container {
      grid-template-columns: 1fr;
    }
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 1px;
    color: var(--ink);
  }
  .footer-tagline {
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.6;
    margin: 0;
  }
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    width: fit-content;
  }
  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 28px;
  }
  .col-title {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .col-list a {
    font-size: 13px;
    color: var(--ink-dim);
    font-weight: 600;
    transition: color 150ms ease;
  }
  .col-list a:hover {
    color: var(--ink);
  }
  .footer-bottom {
    max-width: 1100px;
    margin: 48px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--panel-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-bottom-links a {
    color: var(--ink-dim);
    transition: color 150ms ease;
  }
  .footer-bottom-links a:hover {
    color: var(--ink);
  }
</style>
