---
import { CATEGORIES } from '../../data/tools.js'

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header">
  <a href="/" class="logo-link">
    <div class="logo-badge">
      <span class="logo-spark">✨</span>
    </div>
    <div class="logo-text-group">
      <span class="logo-title">Rocking Tools</span>
      <span class="logo-sub">STUDIO UTILITIES</span>
    </div>
  </a>

  <nav class="site-nav">
    <a href="/" class={currentPath === '/' ? 'nav-item active' : 'nav-item'}>All Tools</a>

    {CATEGORIES.map((cat) => {
      const hasActive = cat.tools.some((t) => currentPath === t.slug)
      return (
        <div class="nav-dropdown">
          <button class={hasActive ? 'dropdown-trigger active' : 'dropdown-trigger'} type="button">
            {cat.heading} <span class="arrow">▾</span>
          </button>
          <div class="dropdown-menu glass-panel">
            {cat.tools.map((tool) => (
              <a href={tool.slug} class={currentPath === tool.slug ? 'dropdown-item active' : 'dropdown-item'}>
                <span class="tool-icon">{tool.icon}</span>
                <div class="tool-info">
                  <span class="tool-name">{tool.navLabel}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    })}

    <a href="/contact" class={currentPath === '/contact' ? 'nav-item active' : 'nav-item'}>Contact</a>
    <a href="/donate" class="support-link" aria-label="Support this project">💛 Support</a>
  </nav>

  <button id="theme-toggle" class="theme-toggle" aria-label="Toggle dark/light theme" type="button">
    <span id="theme-toggle-label">Theme</span>
  </button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--panel-bg);
    backdrop-filter: var(--glass-backdrop);
    -webkit-backdrop-filter: var(--glass-backdrop);
    border-bottom: 1px solid var(--panel-border);
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .logo-badge {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--glow-accent);
  }
  .logo-spark {
    font-size: 16px;
  }
  .logo-text-group {
    display: flex;
    flex-direction: column;
  }
  .logo-title {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
    color: var(--ink);
    line-height: 1.1;
  }
  .logo-sub {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent);
  }
  .site-nav {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .nav-item {
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-dim);
    transition: all 150ms ease;
  }
  .nav-item:hover, .nav-item.active {
    color: var(--ink);
    background: var(--btn-idle-bg);
  }
  .nav-item.active {
    color: var(--accent);
    font-weight: 800;
  }
  .nav-dropdown {
    position: relative;
  }
  .dropdown-trigger {
    padding: 8px 14px;
    border-radius: 8px;
    border: none;
    background: transparent;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 150ms ease;
  }
  .dropdown-trigger:hover, .dropdown-trigger.active {
    color: var(--ink);
    background: var(--btn-idle-bg);
  }
  .dropdown-trigger.active {
    color: var(--accent);
  }
  .arrow {
    font-size: 10px;
    opacity: 0.6;
  }
  .dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 120;
  }
  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    transition: background 120ms ease;
  }
  .dropdown-item:hover {
    background: var(--btn-idle-bg);
  }
  .dropdown-item.active {
    background: var(--accent-light);
    font-weight: 800;
    color: var(--accent);
  }
  .tool-icon {
    font-size: 18px;
  }
  .tool-name {
    font-size: 13px;
    font-weight: 700;
  }
  .site-nav a.support-link {
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 12.5px;
    border: 1px solid var(--accent);
    background: var(--accent-light);
    color: var(--accent);
    text-decoration: none;
    transition: all 150ms ease;
  }
  .site-nav a.support-link:hover {
    box-shadow: var(--glow-accent);
  }
  .theme-toggle {
    border: 1px solid var(--panel-border);
    background: var(--btn-idle-bg);
    color: var(--ink);
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-mono);
    transition: all 150ms ease;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
</style>

<script>
  const STORAGE_KEY = 'toolkit:theme'
  const button = document.getElementById('theme-toggle')
  const label = document.getElementById('theme-toggle-label')

  function currentTheme() {
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'
  }

  function updateLabel() {
    if (label) label.textContent = currentTheme() === 'dark' ? '🌙 Dark' : '☀️ Light'
  }

  updateLabel()

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem(STORAGE_KEY, next)
    } catch {
      // storage unavailable
    }
    updateLabel()
  })
</script>
