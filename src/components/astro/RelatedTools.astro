---
import { relatedTools } from '../../data/tools.js'

interface Props {
  currentSlug: string
}
const { currentSlug } = Astro.props
const related = relatedTools(currentSlug, 3)

// Curated high-traffic cross-category utilities
const TRENDING_CROSS_TOOLS = [
  { name: 'Passport Photo Resizer', slug: '/image-resizer/passport-photo', icon: '📐', desc: 'Exact 2×2 in / 600×600px at 300 DPI' },
  { name: 'Merge PDF Online', slug: '/pdf-tools/merge-pdf', icon: '📄', desc: 'Combine multiple PDF files into one' },
  { name: 'JSON to CSV Converter', slug: '/data-converter/json-to-csv', icon: '🔄', desc: 'Convert JSON objects to CSV tables' },
  { name: 'Strong Password Generator', slug: '/password-checker/strong-password-generator', icon: '🔒', desc: 'Create 24+ char uncrackable keys' },
  { name: 'Email Validation Regex', slug: '/regex-tester/email-regex', icon: '⚡', desc: 'RFC-compliant email regex pattern' },
  { name: 'Every 5 Mins Cron', slug: '/cron-expression-builder/every-5-minutes', icon: '⏰', desc: '*/5 * * * * schedule generator' },
  { name: '300 DPI Print Calculator', slug: '/dpi-calculator/300-dpi', icon: '🖨️', desc: 'Pixel to print size resolution check' },
  { name: 'Wi-Fi QR Code Generator', slug: '/qr-code-generator/wifi', icon: '📶', desc: 'Scan to connect to home/office WiFi' },
  { name: 'Centimeter Screen Ruler', slug: '/ruler/cm-ruler', icon: '📏', desc: 'True 1:1 physical scale cm ruler' },
  { name: 'HEX to RGB Converter', slug: '/color-tools/hex-to-rgb', icon: '🎨', desc: 'Convert HEX color codes to RGB/RGBA' },
  { name: 'BMR & TDEE Calculator', slug: '/bmr-calculator', icon: '🥗', desc: 'Mifflin-St Jeor resting metabolic rate' },
  { name: '9:16 Video Aspect Ratio', slug: '/aspect-ratio/9-16', icon: '📱', desc: 'TikTok, Reels & Shorts dimensions' },
].filter((t) => t.slug !== currentSlug).slice(0, 6)

const TOOL_HUBS = [
  { name: 'Unit Conversions', slug: '/conversions', icon: '🔄' },
  { name: 'Image Resizer', slug: '/image-resizer', icon: '🖼️' },
  { name: 'PDF Tools', slug: '/pdf-tools', icon: '📄' },
  { name: 'Data Converter', slug: '/data-converter', icon: '📊' },
  { name: 'QR Generator', slug: '/qr-code-generator', icon: '📱' },
  { name: 'Password Checker', slug: '/password-checker', icon: '🔒' },
  { name: 'Regex Tester', slug: '/regex-tester', icon: '⚡' },
  { name: 'Cron Builder', slug: '/cron-expression-builder', icon: '🕐' },
  { name: 'DPI Calculator', slug: '/dpi-calculator', icon: '🖨️' },
  { name: 'Screen Ruler', slug: '/ruler', icon: '📏' },
  { name: 'Color Tools', slug: '/color-tools', icon: '🎨' },
  { name: 'Aspect Ratio', slug: '/aspect-ratio-calculator', icon: '📐' },
  { name: 'Health Calculators', slug: '/calorie-calculator', icon: '🥗' },
]
---

<section class="crosslink-container" aria-label="Explore Related Tools and Utilities">
  {related.length > 0 && (
    <div class="related-block">
      <div class="section-title-wrap">
        <span class="section-badge">RELATED UTILITIES</span>
        <h2 class="section-heading">More Tools in This Category</h2>
      </div>
      <div class="related-grid">
        {related.map((tool) => (
          <a href={tool.slug} class="related-card">
            <div class="card-top">
              <div class="icon-box">
                <span class="card-icon" aria-hidden="true">{tool.icon}</span>
              </div>
              <span class="category-pill">{tool.category}</span>
            </div>
            <h3 class="card-name">{tool.name}</h3>
            <p class="card-desc">{tool.description}</p>
            <div class="card-footer">
              <span class="card-cta">Open tool <span class="cta-arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="trending-block">
    <div class="section-title-wrap">
      <span class="section-badge">DISCOVER MORE</span>
      <h3 class="trending-heading">Popular Specialized Calculators &amp; Converters</h3>
    </div>
    <div class="trending-grid">
      {TRENDING_CROSS_TOOLS.map((t) => (
        <a href={t.slug} class="trending-card">
          <div class="trending-icon-box">
            <span class="trending-icon">{t.icon}</span>
          </div>
          <div class="trending-body">
            <span class="trending-title">{t.name}</span>
            <span class="trending-subtitle">{t.desc}</span>
          </div>
          <div class="trending-arrow-box">
            <span class="trending-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="hub-directory-box">
    <div class="hub-header">
      <span class="hub-label">EXPLORE ALL TOOL SUITES</span>
    </div>
    <div class="hub-pill-grid">
      {TOOL_HUBS.map((hub) => (
        <a href={hub.slug} class="hub-pill">
          <span class="hub-icon">{hub.icon}</span>
          <span class="hub-text">{hub.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .crosslink-container {
    max-width: 960px;
    margin: 56px auto 0;
    padding: 0 20px 48px;
  }

  .section-title-wrap {
    margin-bottom: 20px;
  }
  .section-badge {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-light);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 8px;
  }
  .section-heading {
    font-size: clamp(20px, 3.5vw, 24px);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.2px;
  }
  .trending-heading {
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.2px;
  }

  /* ── 3-Column Related Cards ── */
  .related-block {
    margin-bottom: 48px;
    padding-top: 36px;
    border-top: 1px dashed var(--panel-border);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border-radius: 16px;
    border: 1px solid var(--panel-border);
    background: var(--panel-bg);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .related-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-light);
    border: 1px solid rgba(99, 102, 241, 0.15);
  }
  .card-icon {
    font-size: 22px;
  }
  .category-pill {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-light);
    padding: 4px 10px;
    border-radius: 20px;
  }
  .card-name {
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 8px 0;
    line-height: 1.35;
  }
  .card-desc {
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.55;
    margin: 0 0 18px 0;
    flex: 1;
  }
  .card-footer {
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    transition: gap 150ms ease;
  }
  .related-card:hover .cta-arrow {
    transform: translateX(4px);
  }
  .cta-arrow {
    transition: transform 150ms ease;
    font-size: 14px;
  }

  /* ── 2-Column Compact Trending Cards ── */
  .trending-block {
    margin-bottom: 40px;
    padding-top: 36px;
    border-top: 1px solid var(--panel-border);
  }
  .trending-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .trending-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    text-decoration: none;
    transition: all 180ms ease;
  }
  .trending-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    background: var(--panel-bg-hover, rgba(255, 255, 255, 0.03));
  }
  .trending-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-light);
    flex-shrink: 0;
  }
  .trending-icon {
    font-size: 20px;
  }
  .trending-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }
  .trending-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .trending-subtitle {
    font-size: 12px;
    color: var(--ink-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .trending-arrow-box {
    flex-shrink: 0;
    color: var(--ink-faint);
    transition: all 150ms ease;
  }
  .trending-arrow {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    transition: transform 150ms ease;
    display: inline-block;
  }
  .trending-card:hover .trending-arrow {
    transform: translateX(3px);
  }

  /* ── Hub Directory Pill Bar ── */
  .hub-directory-box {
    padding: 24px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hub-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: var(--accent);
  }
  .hub-pill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .hub-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    transition: all 150ms ease;
  }
  .hub-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-light);
    transform: translateY(-1px);
  }
  .hub-icon {
    font-size: 15px;
  }
  .hub-text {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .crosslink-container {
      padding: 0 16px 36px;
    }
    .trending-grid {
      grid-template-columns: 1fr;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .hub-directory-box {
      padding: 18px 16px;
    }
  }
</style>
