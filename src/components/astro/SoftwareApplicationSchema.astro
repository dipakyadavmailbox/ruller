---
import { SITE_CONFIG } from '../../siteConfig.js'

interface Props {
  name: string
  description: string
  path: string
  image?: string
}
const { name, description, path, image: customImage } = Astro.props

const toolSlug = path.replace(/^\//, '').replace(/\.html$/, '') || 'home'
const imageUrl = customImage 
  ? (customImage.startsWith('http') ? customImage : `${SITE_CONFIG.domain}${customImage}`)
  : `${SITE_CONFIG.domain}/og/${toolSlug}.png`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  url: `${SITE_CONFIG.domain}${path}`,
  image: imageUrl,
  thumbnailUrl: imageUrl,
  screenshot: imageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (runs in browser)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
