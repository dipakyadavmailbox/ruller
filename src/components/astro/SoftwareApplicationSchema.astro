---
import { SITE_CONFIG } from '../../siteConfig.js'

interface Props {
  name: string
  description: string
  path: string
  image?: string
}
const { name, description, path, image: customImage } = Astro.props

const toolSlug = path.replace(/^\//, '').replace(/\.html$/, '').split('/')[0] || 'home'
const OG_SLUGS = new Set([
  'about', 'aspect-ratio-calculator', 'calorie-calculator', 'color-tools',
  'cron-expression-builder', 'data-converter', 'donate', 'dpi-calculator',
  'faq', 'home', 'image-resizer', 'password-checker', 'pdf-tools',
  'pregnancy-calculator', 'qr-code-generator', 'regex-tester', 'ruler',
  'unit-converter', 'workspace', 'contact', 'privacy', 'terms', 'accessibility', 'dmca', 'sitemap'
])

const defaultOgPath = OG_SLUGS.has(toolSlug) ? `/og/${toolSlug}.png` : '/og-image.png'
const imageUrl = customImage 
  ? (customImage.startsWith('http') ? customImage : `${SITE_CONFIG.domain}${customImage}`)
  : `${SITE_CONFIG.domain}${defaultOgPath}`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  url: `${SITE_CONFIG.domain}${path}`,
  image: imageUrl,
  thumbnailUrl: imageUrl,
  screenshot: imageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (runs in browser)',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
