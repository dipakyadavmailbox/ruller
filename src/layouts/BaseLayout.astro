---
import Nav from '../components/astro/Nav.astro'
import Footer from '../components/astro/Footer.astro'
import HeadMeta from '../components/astro/HeadMeta.astro'
import LocaleSuggestion from '../components/astro/LocaleSuggestion.astro'
import '../styles/global.css'
import { DEFAULT_LOCALE, getLocale } from '../i18n/config.js'
import { t } from '../i18n/ui.js'

interface Props {
  title: string
  description: string
  /** Locale-free canonical path, e.g. '/ruler'. Never include the prefix. */
  path: string
  /** BCP-47 code from src/i18n/config.js. Defaults to English. */
  lang?: string
  keywords?: string
  ogImage?: string
  type?: string
  noindex?: boolean
}

const {
  title,
  description,
  path,
  lang = DEFAULT_LOCALE,
  keywords,
  ogImage,
  type = 'website',
  noindex = false,
} = Astro.props

const locale = getLocale(lang)
---

<!doctype html>
<html lang={locale.code} dir={locale.dir}>
  <head>
    <HeadMeta
      title={title}
      description={description}
      path={path}
      lang={locale.code}
      keywords={keywords}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t(locale.code, 'common.skipToContent')}</a>
    <LocaleSuggestion path={path} lang={locale.code} />
    <Nav lang={locale.code} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={locale.code} />
  </body>
</html>
