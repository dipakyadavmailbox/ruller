---
/**
 * MinimalLayout — full-bleed viewport shell with no nav or footer chrome.
 * Used by the screen ruler, which needs the whole viewport to render a
 * physically accurate scale.
 *
 * It now shares HeadMeta with BaseLayout, so it picks up hreflang, consent
 * mode, and the AdSense loader that it was previously missing.
 */
import HeadMeta from '../components/astro/HeadMeta.astro'
import '../styles/global.css'
import { DEFAULT_LOCALE, getLocale } from '../i18n/config.js'

interface Props {
  title: string
  description: string
  /** Locale-free canonical path, e.g. '/ruler'. Never include the prefix. */
  path: string
  lang?: string
  keywords?: string
  ogImage?: string
  type?: string
  noindex?: boolean
}

const {
  title,
  description,
  path,
  lang = DEFAULT_LOCALE,
  keywords,
  ogImage,
  type = 'website',
  noindex = false,
} = Astro.props

const locale = getLocale(lang)
---

<!doctype html>
<html lang={locale.code} dir={locale.dir}>
  <head>
    <HeadMeta
      title={title}
      description={description}
      path={path}
      lang={locale.code}
      keywords={keywords}
      ogImage={ogImage}
      type={type}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body style="margin:0; overflow:hidden;">
    <slot />
  </body>
</html>
