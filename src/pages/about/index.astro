---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/astro/Breadcrumb.astro";
import { SITE_CONFIG } from "../../siteConfig.js";
import { CATEGORIES } from "../../data/tools.js";

const title = "About Us — Rocking Tools | Free Private Browser Utilities";
const description =
  "Learn what Rocking Tools is, why we built it, and the principles that guide every tool — zero data collection, zero signup, 100% client-side privacy.";
const keywords =
  "about rocking tools, free browser tools, private online tools, no signup tools, client side utilities, about us, who we are, browser privacy tools";

const principles = [
  {
    icon: "🔒",
    title: "Privacy by architecture",
    body: "We chose a design where data cannot leave your device — not as a feature toggle, but as the only way the tools work. There is no backend to send data to.",
  },
  {
    icon: "⚡",
    title: "Speed over everything",
    body: "No round-trips to a server means results are instant. Every tool computes locally in your browser, so the output appears as fast as your CPU can produce it.",
  },
  {
    icon: "🎯",
    title: "One tool, one job",
    body: "Each tool in our studio does exactly one thing and does it precisely. No feature creep, no bundled upsells, no dark patterns — just the tool and its result.",
  },
  {
    icon: "🌍",
    title: "Free for everyone",
    body: "There are no free tiers that hide the useful parts. Every feature of every tool is always free. Optional donations keep the lights on for everyone.",
  },
];

const timeline = [
  {
    year: "2024",
    title: "Started with a ruler",
    body: "The first tool was a simple on-screen ruler — built because every existing one required Flash, an app install, or a server ping just to measure an object on a desk. We proved a browser could do it natively, at true physical scale.",
  },
  {
    year: "2025",
    title: "Grew into a studio",
    body: "Developers, designers, and health-conscious users kept asking for more precise, private alternatives to the tools they already used. We answered with the Regex Tester, DPI Calculator, Password Checker, Calorie Calculator, and more.",
  },
  {
    year: "2026",
    title: "Refined & expanding",
    body: "Today the studio holds nine precision tools across four disciplines. We are actively building more — always guided by the same constraint: if it needs a server to work, we will find a way to make it not need one.",
  },
];

const toolCount = CATEGORIES.flatMap((c) => c.tools).length;
---

<BaseLayout
  title={title}
  description={description}
  path="/about"
  keywords={keywords}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      name: title,
      description: description,
      url: `${SITE_CONFIG.domain}/about`,
      publisher: {
        "@type": "Organization",
        name: SITE_CONFIG.siteName,
        url: SITE_CONFIG.domain,
        logo: `${SITE_CONFIG.domain}/logo.svg`,
        email: SITE_CONFIG.contactEmail,
      },
    })}
    slot="head"
  />

  <Breadcrumb items={[{ label: "Home", path: "/" }, { label: "About Us" }]} />

  <!-- ── HERO ── -->
  <section class="about-hero">
    <div class="hero-inner">
      <div class="hero-label">OUR STORY</div>
      <h1>
        Built for people who need<br /><span class="gradient-text"
          >answers, not accounts.</span>
      </h1>
      <p class="hero-lead">
        Rocking Tools is a small, independent studio of browser utilities. Every
        tool runs entirely on your device — no servers, no sign-ups, no
        surveillance. Just precision, instantly.
      </p>
      <div class="hero-meta">
        <div class="meta-stat">
          <span class="meta-val">{toolCount}</span>
          <span class="meta-key">precision tools</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-stat">
          <span class="meta-val">0</span>
          <span class="meta-key">bytes uploaded</span>
        </div>
        <div class="meta-divider"></div>
        <div class="meta-stat">
          <span class="meta-val">∞</span>
          <span class="meta-key">free forever</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── MISSION ── -->
  <section class="mission-section">
    <div class="section-eyebrow">THE MISSION</div>
    <div class="mission-grid">
      <div class="mission-copy">
        <h2>The web shouldn't ask for your email just to measure a pixel.</h2>
        <p>
          Most "free" online tools are free in exchange for your attention, your
          email address, or your data. We found that pattern exhausting. Rocking
          Tools exists because the browser is powerful enough to do almost
          anything locally — and we wanted to prove it, one tool at a time.
        </p>
        <p>
          We write every tool as if privacy is a hard constraint, not a
          preference. That means every calculation, every file operation, and
          every password check happens in your browser tab and nowhere else. You
          can turn off your Wi-Fi after the page loads and every tool keeps
          working.
        </p>
        <a href="/contact" class="mission-cta">Send us a message →</a>
      </div>
      <div class="mission-visual" aria-hidden="true">
        <div class="visual-card">
          <div class="vc-bar vc-bar--full"></div>
          <div class="vc-bar vc-bar--mid"></div>
          <div class="vc-bar vc-bar--short"></div>
          <div class="vc-label">Your browser</div>
          <div class="vc-sublabel">All computation happens here</div>
        </div>
        <div class="visual-arrow">
          <div class="arrow-line"></div>
          <div class="arrow-blocked">✗ no server</div>
        </div>
        <div class="visual-card visual-card--dim">
          <div class="vc-icon">🌐</div>
          <div class="vc-label">The internet</div>
          <div class="vc-sublabel">Never reached</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PRINCIPLES ── -->
  <section class="principles-section">
    <div class="section-eyebrow">WHAT WE STAND FOR</div>
    <h2 class="section-heading">Four principles, no exceptions.</h2>
    <div class="principles-grid">
      {
        principles.map((p) => (
          <div class="principle-card">
            <div class="pc-icon" aria-hidden="true">
              {p.icon}
            </div>
            <h3 class="pc-title">{p.title}</h3>
            <p class="pc-body">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── STORY TIMELINE ── -->
  <section class="story-section">
    <div class="section-eyebrow">HOW WE GOT HERE</div>
    <h2 class="section-heading">A studio built one tool at a time.</h2>
    <div class="timeline">
      {
        timeline.map((item, i) => (
          <div class="timeline-item">
            <div class="timeline-left">
              <div class="tl-year">{item.year}</div>
              {i < timeline.length - 1 && (
                <div class="tl-connector" aria-hidden="true" />
              )}
            </div>
            <div class="timeline-content">
              <h3 class="tl-title">{item.title}</h3>
              <p class="tl-body">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── TOOLS SNAPSHOT ── -->
  <section class="tools-section">
    <div class="section-eyebrow">THE STUDIO</div>
    <h2 class="section-heading">Every tool, every category.</h2>
    <div class="tools-categories">
      {
        CATEGORIES.map((cat) => (
          <div class="tools-cat-block">
            <div class="cat-label">{cat.heading}</div>
            <div class="cat-tools">
              {cat.tools.map((tool) => (
                <a href={tool.slug} class="tool-chip">
                  <span class="chip-icon" aria-hidden="true">
                    {tool.icon}
                  </span>
                  <span class="chip-name">{tool.navLabel}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ── WHO'S BEHIND THIS ── -->
  <section class="identity-section">
    <div class="section-eyebrow">WHO WE ARE</div>
    <h2 class="section-heading">The person behind Rocking Tools.</h2>
    <div class="identity-card">
      <div class="identity-grid">
        <div class="identity-block">
          <div class="identity-label">Name</div>
          <div class="identity-value">Dipak Kumar</div>
        </div>
        <div class="identity-block">
          <div class="identity-label">Address</div>
          <div class="identity-value">
            Sector 71, Noida<br />
            Uttar Pradesh — 201301<br />
            India
          </div>
        </div>
        <div class="identity-block">
          <div class="identity-label">Business Type</div>
          <div class="identity-value">Private Limited Company</div>
        </div>
        <div class="identity-block">
          <div class="identity-label">Contact</div>
          <div class="identity-value">
            <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="identity-link"
              >{SITE_CONFIG.contactEmail}</a
            >
          </div>
        </div>
        <div class="identity-block">
          <div class="identity-label">Website</div>
          <div class="identity-value">
            <a href={SITE_CONFIG.domain} class="identity-link"
              >{SITE_CONFIG.domain.replace("https://", "")}</a
            >
          </div>
        </div>
      </div>
      <p class="identity-desc">
        RockingTools Pvt Ltd is an independent software company based in Noida,
        India. We build free, browser-native utility tools used by developers,
        designers, students, and health-conscious individuals worldwide. Every
        tool we ship runs entirely on the user's device — no servers, no data
        collection, no subscriptions. We are funded entirely by non-intrusive
        Google AdSense advertising and optional voluntary donations.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-icon" aria-hidden="true">✨</div>
      <h2 class="cta-heading">Have a tool idea or found a bug?</h2>
      <p class="cta-desc">
        We read every message. The best tools on this site started as user
        suggestions.
      </p>
      <div class="cta-actions">
        <a href="/contact" class="btn-primary">Contact us</a>
        <a href="/" class="btn-ghost">Browse all tools →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── SHARED ── */
  .section-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent);
    margin-bottom: 10px;
    text-transform: uppercase;
  }
  .section-heading {
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.2;
    margin: 0 0 36px;
    letter-spacing: -0.3px;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── HERO ── */
  .about-hero {
    padding: 60px 20px 52px;
    display: flex;
    justify-content: center;
  }
  .hero-inner {
    max-width: 780px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero-label {
    display: inline-flex;
    padding: 5px 14px;
    border-radius: 20px;
    background: var(--accent-light);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
  }
  h1 {
    font-size: clamp(30px, 5.5vw, 52px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.1;
    letter-spacing: -0.8px;
    margin: 0;
  }
  .hero-lead {
    font-size: clamp(15px, 2vw, 17px);
    color: var(--ink-dim);
    line-height: 1.7;
    max-width: 580px;
    margin: 0;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 18px 36px;
    border-radius: 16px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    margin-top: 4px;
  }
  .meta-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .meta-val {
    font-size: 26px;
    font-weight: 900;
    color: var(--ink);
    font-family: var(--font-mono);
    line-height: 1;
  }
  .meta-key {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-faint);
    letter-spacing: 0.4px;
    white-space: nowrap;
  }
  .meta-divider {
    width: 1px;
    height: 32px;
    background: var(--panel-border);
  }

  /* ── MISSION ── */
  .mission-section {
    max-width: 1040px;
    margin: 0 auto 72px;
    padding: 0 20px;
  }
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .mission-copy h2 {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.25;
    margin: 0 0 20px;
    letter-spacing: -0.3px;
  }
  .mission-copy p {
    font-size: 14.5px;
    color: var(--ink-dim);
    line-height: 1.75;
    margin: 0 0 16px;
  }
  .mission-cta {
    display: inline-flex;
    align-items: center;
    font-size: 13.5px;
    font-weight: 800;
    color: var(--accent);
    text-decoration: none;
    margin-top: 8px;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease;
  }
  .mission-cta:hover {
    border-color: var(--accent);
  }

  /* Visual diagram */
  .mission-visual {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: center;
  }
  .visual-card {
    flex: 1;
    padding: 22px 20px;
    border-radius: 14px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    min-width: 0;
  }
  .visual-card--dim {
    opacity: 0.45;
  }
  .vc-bar {
    height: 5px;
    border-radius: 3px;
    background: var(--accent);
    margin-bottom: 2px;
  }
  .vc-bar--full {
    width: 100%;
  }
  .vc-bar--mid {
    width: 72%;
    background: var(--accent-cyan);
  }
  .vc-bar--short {
    width: 48%;
    background: var(--accent);
    opacity: 0.5;
  }
  .vc-icon {
    font-size: 26px;
  }
  .vc-label {
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
    margin-top: 4px;
  }
  .vc-sublabel {
    font-size: 11px;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .visual-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .arrow-line {
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(239, 68, 68, 0.6));
    position: relative;
  }
  .arrow-line::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -4px;
    border-left: 8px solid rgba(239, 68, 68, 0.6);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  .arrow-blocked {
    font-size: 11px;
    font-weight: 800;
    color: #ef4444;
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  /* ── PRINCIPLES ── */
  .principles-section {
    max-width: 1040px;
    margin: 0 auto 72px;
    padding: 0 20px;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .principle-card {
    padding: 28px 24px;
    border-radius: 16px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }
  .principle-card:hover {
    border-color: rgba(99, 102, 241, 0.35);
    transform: translateY(-2px);
  }
  .pc-icon {
    font-size: 28px;
    margin-bottom: 14px;
  }
  .pc-title {
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .pc-body {
    font-size: 13.5px;
    color: var(--ink-dim);
    line-height: 1.7;
    margin: 0;
  }

  /* ── TIMELINE ── */
  .story-section {
    max-width: 720px;
    margin: 0 auto 72px;
    padding: 0 20px;
  }
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .timeline-item {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }
  .timeline-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 60px;
    padding-top: 4px;
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 800;
    color: var(--accent);
    background: var(--accent-light);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid rgba(99, 102, 241, 0.2);
    white-space: nowrap;
    text-align: center;
  }
  .tl-connector {
    width: 2px;
    flex: 1;
    min-height: 48px;
    background: linear-gradient(to bottom, var(--accent), var(--panel-border));
    margin: 10px 0;
    border-radius: 2px;
  }
  .timeline-content {
    padding-bottom: 44px;
  }
  .timeline-item:last-child .timeline-content {
    padding-bottom: 0;
  }
  .tl-title {
    font-size: 17px;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 10px;
    line-height: 1.3;
  }
  .tl-body {
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.72;
    margin: 0;
  }

  /* ── TOOLS SNAPSHOT ── */
  .tools-section {
    max-width: 1040px;
    margin: 0 auto 72px;
    padding: 0 20px;
  }
  .tools-categories {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .tools-cat-block {
    padding: 24px;
    border-radius: 14px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
  }
  .cat-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .cat-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 100px;
    background: var(--btn-idle-bg);
    border: 1px solid var(--panel-border);
    text-decoration: none;
    transition: all 160ms ease;
  }
  .tool-chip:hover {
    background: var(--accent-light);
    border-color: rgba(99, 102, 241, 0.35);
    transform: translateY(-1px);
  }
  .chip-icon {
    font-size: 15px;
  }
  .chip-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .tool-chip:hover .chip-name {
    color: var(--accent);
  }

  /* ── CTA ── */
  .cta-section {
    max-width: 1040px;
    margin: 0 auto 0;
    padding: 0 20px 80px;
  }
  .cta-inner {
    padding: 52px 40px;
    border-radius: 20px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    box-shadow: var(--shadow-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .cta-icon {
    font-size: 36px;
  }
  .cta-heading {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 900;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.3px;
  }
  .cta-desc {
    font-size: 14.5px;
    color: var(--ink-dim);
    line-height: 1.6;
    max-width: 440px;
    margin: 0;
  }
  .cta-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 12px 28px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: all 180ms ease;
    box-shadow: 0 4px 20px -4px rgba(99, 102, 241, 0.5);
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -4px rgba(99, 102, 241, 0.6);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--btn-idle-bg);
    border: 1px solid var(--panel-border);
    color: var(--ink-dim);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 180ms ease;
  }
  .btn-ghost:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 800px) {
    .mission-grid {
      grid-template-columns: 1fr;
    }
    .mission-visual {
      order: -1;
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .about-hero {
      padding: 36px 16px 40px;
    }
    .hero-meta {
      gap: 18px;
      padding: 16px 20px;
    }
    .meta-val {
      font-size: 22px;
    }
    .mission-section,
    .principles-section,
    .story-section,
    .tools-section,
    .identity-section,
    .cta-section {
      padding: 0 16px;
      margin-bottom: 52px;
    }
    .cta-inner {
      padding: 36px 20px;
    }
    .timeline-left {
      width: 52px;
    }
    .mission-visual {
      flex-wrap: wrap;
      gap: 10px;
    }
    .visual-arrow {
      flex-direction: row;
    }
    .arrow-line {
      width: 30px;
    }
