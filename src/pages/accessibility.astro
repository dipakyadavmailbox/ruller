---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import { SITE_CONFIG } from '../siteConfig.js'

const title = `Accessibility Statement — ${SITE_CONFIG.siteName}`
const description = `${SITE_CONFIG.siteName}'s commitment to web accessibility and WCAG 2.1 AA conformance.`
const accessibilityEmail = SITE_CONFIG.legal.accessibilityEmail || SITE_CONFIG.contactEmail
---

<BaseLayout title={title} description={description} path="/accessibility">
  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Accessibility' }]} />

  <div class="page">
    <h1>Accessibility Statement</h1>
    <p class="subtitle">Last updated: {SITE_CONFIG.legal.lastUpdated}</p>

    <div class="notice">
      This statement describes our accessibility goals and current
      status honestly — it's not a certification. Full WCAG conformance
      requires an actual audit (automated + manual + screen-reader
      testing); treat the items below as a starting checklist, not a
      completed one.
    </div>

    <section>
      <h2>Our commitment</h2>
      <p>{SITE_CONFIG.siteName} aims to conform to the Web Content Accessibility Guidelines (WCAG) 2.1, Level AA — the standard most commonly referenced under the Americans with Disabilities Act (ADA) for web accessibility.</p>
    </section>

    <section>
      <h2>What's implemented</h2>
      <ul>
        <li>Semantic HTML with a logical heading hierarchy on every page</li>
        <li>A skip-to-content link for keyboard and screen-reader users</li>
        <li>Visible focus indicators on all interactive elements</li>
        <li>Sufficient color contrast in both the dark and light themes</li>
        <li>Keyboard-operable navigation, forms, and tool controls</li>
        <li>Alt text on meaningful images</li>
      </ul>
    </section>

    <section>
      <h2>Known limitations</h2>
      <p>Some of the more visually complex tools (the screen ruler, the regex match highlighter, drag-and-drop image upload) have not yet had full manual screen-reader testing. If you encounter a barrier using any tool with assistive technology, please report it — see below.</p>
    </section>

    <section>
      <h2>Feedback</h2>
      <p>If you experience an accessibility barrier anywhere on this site, contact us at <a href={`mailto:${accessibilityEmail}`} class="accent-link">{accessibilityEmail}</a> with the page and a description of the issue. We aim to acknowledge accessibility reports promptly and address them as quickly as we reasonably can.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 48px 20px 60px; }
  h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .subtitle { font-size: 13px; color: var(--ink-faint); margin-bottom: 28px; }
  .notice {
    font-size: 12.5px; color: var(--ink-faint); padding: 12px 14px;
    border: 1px solid var(--panel-border); border-radius: 8px;
    background: var(--panel-bg); margin-bottom: 24px;
  }
  section { margin-bottom: 24px; }
  h2 { font-size: 16px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  p { font-size: 14px; color: var(--ink-dim); line-height: 1.75; }
  ul { padding-left: 20px; margin: 8px 0; color: var(--ink-dim); font-size: 14px; line-height: 1.75; }
  .accent-link { color: var(--accent); font-weight: 700; text-decoration: none; }
</style>
