---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import ContactForm from '../components/react/shared/ContactForm.jsx'
import { SITE_CONFIG } from '../siteConfig.js'

const title = `Contact Us — ${SITE_CONFIG.siteName}`
const description = `Get in touch with ${SITE_CONFIG.siteName} — questions, bug reports, or feedback on any tool.`
---

<BaseLayout title={title} description={description} path="/contact">
  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Contact' }]} />

  <div class="page">
    <h1>Contact Us</h1>
    <p class="subtitle">Questions, bug reports, or feature ideas — we would love to hear from you.</p>

    <p style="margin-bottom: 24px;">
      Use the form below to send us a message directly or email us at
      <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="accent-link">{SITE_CONFIG.contactEmail}</a>.
    </p>

    <ContactForm client:only="react" contactEmail={SITE_CONFIG.contactEmail} />
  </div>
</BaseLayout>

<style>
  .page { max-width: 760px; margin: 0 auto; padding: 32px 20px 60px; }
  h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .subtitle { font-size: 14px; color: var(--ink-faint); margin-bottom: 24px; }
  p { font-size: 14px; color: var(--ink-dim); line-height: 1.7; }
  .accent-link { color: var(--accent); font-weight: 700; text-decoration: none; }
</style>
