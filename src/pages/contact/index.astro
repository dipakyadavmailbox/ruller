---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import ContactForm from '../../components/react/shared/ContactForm.jsx'
import { SITE_CONFIG } from '../../siteConfig.js'

const title = `Contact Us — ${SITE_CONFIG.siteName}`
const description = `Contact RockingTools Pvt Ltd — questions, bug reports, feature requests, or business enquiries. We are based in Noida, Uttar Pradesh, India.`
---

<BaseLayout title={title} description={description} path="/contact">
  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Contact' }]} />

  <div class="page">
    <h1>Contact Us</h1>
    <p class="subtitle">Questions, bug reports, or feature ideas — we would love to hear from you.</p>

    <!-- Company info block — static HTML, always visible to crawlers -->
    <div class="company-info">
      <div class="info-grid">
        <div class="info-block">
          <div class="info-label">Company</div>
          <div class="info-val">RockingTools Pvt Ltd</div>
        </div>
        <div class="info-block">
          <div class="info-label">Registered Office</div>
          <div class="info-val">
            Sector 71, Noida<br />
            Uttar Pradesh — 201301<br />
            India
          </div>
        </div>
        <div class="info-block">
          <div class="info-label">Email</div>
          <div class="info-val">
            <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="accent-link">
              {SITE_CONFIG.contactEmail}
            </a>
          </div>
        </div>
        <div class="info-block">
          <div class="info-label">Response Time</div>
          <div class="info-val">We reply within 1–2 business days.</div>
        </div>
      </div>
    </div>

    <p class="form-intro">
      You can also send us a message directly using the form below. Emails are the fastest
      way to reach us for urgent bug reports or business enquiries.
    </p>

    <ContactForm client:load contactEmail={SITE_CONFIG.contactEmail} />

    <div class="other-links">
      <p>Other helpful pages:</p>
      <ul>
        <li><a href="/about" class="accent-link">About RockingTools Pvt Ltd</a> — who we are and our mission</li>
        <li><a href="/privacy" class="accent-link">Privacy Policy</a> — what data we collect (spoiler: almost none)</li>
        <li><a href="/faq" class="accent-link">FAQ</a> — common questions about our tools</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .page { max-width: 760px; margin: 0 auto; padding: 32px 20px 80px; }
  h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .subtitle { font-size: 14px; color: var(--ink-faint); margin-bottom: 28px; }

  .company-info {
    padding: 24px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    margin-bottom: 24px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }
  .info-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .info-val {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.65;
  }

  .form-intro { font-size: 14px; color: var(--ink-dim); line-height: 1.7; margin-bottom: 24px; }
  p { font-size: 14px; color: var(--ink-dim); line-height: 1.7; }

  .other-links {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--panel-border);
  }
  .other-links p { margin-bottom: 10px; font-weight: 600; color: var(--ink); }
  .other-links ul { padding-left: 18px; }
  .other-links li { font-size: 14px; color: var(--ink-dim); line-height: 1.7; margin-bottom: 6px; }

  .accent-link { color: var(--accent); font-weight: 700; text-decoration: none; }
  .accent-link:hover { text-decoration: underline; }
</style>
