---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import { SITE_CONFIG } from '../siteConfig.js'

const title = `DMCA Policy — ${SITE_CONFIG.siteName}`
const description = `How to submit a copyright takedown notice for ${SITE_CONFIG.siteName} under the Digital Millennium Copyright Act.`
const dmcaEmail = SITE_CONFIG.legal.dmcaEmail || SITE_CONFIG.contactEmail
---

<BaseLayout title={title} description={description} path="/dmca">
  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'DMCA Policy' }]} />

  <div class="page">
    <h1>DMCA Policy</h1>
    <p class="subtitle">Last updated: {SITE_CONFIG.legal.lastUpdated}</p>

    <div class="notice">
      Template only, not legal advice — have a lawyer confirm this
      satisfies 17 U.S.C. § 512(c) safe-harbor requirements for your
      specific setup before relying on it, especially if you later add
      user-uploaded content.
    </div>

    <section>
      <h2>Our position</h2>
      <p>
        {SITE_CONFIG.siteName} does not host user-uploaded content — every
        tool runs client-side in your browser, and nothing you enter or
        upload (including in the image resizer) is transmitted to or
        stored on our servers. That said, we take copyright seriously and
        provide this notice-and-takedown process for any original content
        we do publish (page text, graphics, code) in case of a good-faith
        dispute.
      </p>
    </section>

    <section>
      <h2>Filing a takedown notice</h2>
      <p>If you believe content on this site infringes your copyright, send a written notice to <a href={`mailto:${dmcaEmail}`} class="accent-link">{dmcaEmail}</a> that includes:</p>
      <ul>
        <li>A physical or electronic signature of the copyright owner or their authorized agent</li>
        <li>Identification of the copyrighted work claimed to be infringed</li>
        <li>Identification of the material you claim is infringing, with enough detail (e.g. a URL) for us to locate it</li>
        <li>Your contact information — address, phone number, and email</li>
        <li>A statement that you have a good-faith belief the use is not authorized by the copyright owner, its agent, or the law</li>
        <li>A statement, under penalty of perjury, that the above information is accurate and that you are the copyright owner or authorized to act on their behalf</li>
      </ul>
    </section>

    <section>
      <h2>Counter-notice</h2>
      <p>If you believe material was removed in error, you may submit a counter-notice with: your physical or electronic signature; identification of the removed material and where it appeared before removal; a statement under penalty of perjury that you have a good-faith belief the material was removed as a result of mistake or misidentification; and your name, address, and phone number, along with a statement consenting to the jurisdiction of the federal court in your district (or, if outside the US, an appropriate judicial district) and that you'll accept service of process from the person who filed the original notice.</p>
    </section>

    <section>
      <h2>Response</h2>
      <p>We'll review and respond to valid notices promptly, which may include removing or disabling access to the disputed content.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 48px 20px 60px; }
  h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .subtitle { font-size: 13px; color: var(--ink-faint); margin-bottom: 28px; }
  .notice {
    font-size: 12.5px; color: var(--ink-faint); padding: 12px 14px;
    border: 1px solid var(--panel-border); border-radius: 8px;
    background: var(--panel-bg); margin-bottom: 24px;
  }
  section { margin-bottom: 24px; }
  h2 { font-size: 16px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  p { font-size: 14px; color: var(--ink-dim); line-height: 1.75; }
  ul { padding-left: 20px; margin: 8px 0; color: var(--ink-dim); font-size: 14px; line-height: 1.75; }
  .accent-link { color: var(--accent); font-weight: 700; text-decoration: none; }
</style>
