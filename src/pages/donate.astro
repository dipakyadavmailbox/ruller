---
import BaseLayout from '../layouts/BaseLayout.astro'
import FaqSchema from '../components/astro/FaqSchema.astro'
import { SITE_CONFIG } from '../siteConfig.js'

const title = `Support Us — ${SITE_CONFIG.siteName}`
const description = `Help keep ${SITE_CONFIG.siteName} free forever. See exactly where donations go and pick a way to support the project.`

const { monthlyGoal, currentRaised, expenses, methods } = SITE_CONFIG.donation
const monthlyExpenses = expenses.reduce((sum, e) => sum + e.amount, 0)
const progressPercent = Math.min(100, Math.round((currentRaised / monthlyGoal) * 100))

const METHOD_META = {
  upi: { icon: '📱', blurb: 'Instant, no fees, works with any UPI app.' },
  paypal: { icon: '💳', blurb: 'One-time or recurring, worldwide.' },
  buymeacoffee: { icon: '☕', blurb: 'A quick one-off thank-you.' },
  githubsponsors: { icon: '🐙', blurb: 'Support development directly through GitHub.' },
  stripe: { icon: '💳', blurb: 'Pay by card, one-time or monthly.' },
  razorpay: { icon: '🇮🇳', blurb: 'Card, UPI, or netbanking (India).' },
}

const FAQ = [
  { q: 'Do I have to pay to use the tools?', a: 'No — every tool on this site is free and will stay free. Donations just help cover hosting and development time.' },
  { q: 'Where does the money go?', a: 'Straight to keeping the site running — hosting, domain renewal, and time spent building and maintaining tools. See the transparency section above for the actual breakdown.' },
  { q: 'Can I get a receipt or invoice?', a: 'Depends on the method — platforms like Stripe and PayPal typically email you a receipt automatically. For UPI, check your app.' },
  { q: 'Is this a registered non-profit?', a: 'No — this is an independent, self-funded project, not a registered charity. Donations aren\u2019t tax-deductible unless stated otherwise.' },
]
---

<BaseLayout title={title} description={description} path="/donate">
  <FaqSchema slot="head" items={FAQ} />

  <div class="page">
    <div class="hero">
      <div class="hero-icon" aria-hidden="true">💛</div>
      <h1>Help keep these tools free — forever</h1>
      <p>{SITE_CONFIG.siteName} runs on no ads by default and no paywalls. Donations cover the real, ongoing cost of hosting and building new tools.</p>
    </div>

    <div class="progress-card">
      <div class="progress-row">
        <span>${currentRaised} raised this month</span>
        <span class="faint">Goal: ${monthlyGoal}</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width: ${progressPercent}%`}></div>
      </div>
    </div>

    <div class="section-label">WAYS TO SUPPORT</div>
    <div class="methods-grid">
      {methods.map((m) => {
        const meta = METHOD_META[m.id] ?? { icon: '💰', blurb: '' }
        const isReady = m.enabled && (m.href || (m.id === 'upi' && m.upiId))
        return (
          <div class={`method-card ${isReady ? '' : 'not-ready'}`}>
            <div class="method-icon" aria-hidden="true">{meta.icon}</div>
            <div class="method-name">{m.label}</div>
            <div class="method-blurb">{meta.blurb}</div>
            {isReady ? (
              m.id === 'upi' ? (
                <div class="method-value">{m.upiId}</div>
              ) : (
                <a href={m.href} target="_blank" rel="noopener noreferrer" class="method-link">Support via {m.label} →</a>
              )
            ) : (
              <div class="method-soon">Coming soon</div>
            )}
          </div>
        )
      })}
    </div>

    <div class="section-label">TRANSPARENCY — WHERE IT GOES</div>
    <div class="expenses-card">
      {expenses.map((e) => (
        <div class="expense-row">
          <span class="faint">{e.label}</span>
          <span class="expense-amount">${e.amount}/mo</span>
        </div>
      ))}
      <div class="expense-row expense-total">
        <span>Total monthly cost</span>
        <span>${monthlyExpenses}/mo</span>
      </div>
    </div>

    <div class="section-label">WHAT YOUR SUPPORT MAKES POSSIBLE</div>
    <ul class="benefits-list">
      <li>Keeps every tool free, with no paywalls or required signup</li>
      <li>Covers hosting so the site stays fast and reliable</li>
      <li>Funds time spent building new tools and fixing bugs</li>
      <li>Keeps the site ad-light — donations reduce the need for intrusive ads</li>
    </ul>

    <div class="section-label">FAQ</div>
    <div class="faq-card">
      {FAQ.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 48px 20px 60px; }
  .hero { text-align: center; margin-bottom: 40px; }
  .hero-icon { font-size: 40px; margin-bottom: 12px; }
  .hero h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 800; color: var(--ink); margin-bottom: 10px; }
  .hero p { font-size: 14px; color: var(--ink-dim); max-width: 480px; margin: 0 auto; line-height: 1.6; }

  .progress-card { padding: 20px 22px; border-radius: 12px; border: 1px solid var(--panel-border); background: var(--panel-bg); margin-bottom: 32px; }
  .progress-row { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
  .faint { color: var(--ink-faint); }
  .progress-track { height: 8px; border-radius: 4px; background: var(--btn-idle-bg); overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent); }

  .section-label { font-size: 11px; font-weight: 700; letter-spacing: 0.5px; color: var(--ink-faint); margin-bottom: 12px; }

  .methods-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 36px; }
  .method-card { padding: 16px; border-radius: 10px; border: 1px solid var(--panel-border); background: var(--panel-bg); }
  .method-card.not-ready { opacity: 0.55; }
  .method-icon { font-size: 22px; margin-bottom: 8px; }
  .method-name { font-size: 13px; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
  .method-blurb { font-size: 11.5px; color: var(--ink-dim); margin-bottom: 12px; }
  .method-link { font-size: 12px; font-weight: 700; color: var(--accent); text-decoration: none; }
  .method-value { font-size: 12px; font-weight: 700; color: var(--ink); }
  .method-soon { font-size: 11.5px; font-weight: 700; color: var(--ink-faint); }

  .expenses-card { border: 1px solid var(--panel-border); border-radius: 10px; overflow: hidden; margin-bottom: 36px; }
  .expense-row { display: flex; justify-content: space-between; padding: 10px 16px; font-size: 13px; border-top: 1px solid var(--panel-border); }
  .expense-row:first-child { border-top: none; }
  .expense-amount { font-weight: 700; color: var(--ink); }
  .expense-total { background: var(--btn-idle-bg); font-weight: 800; color: var(--ink); }

  .benefits-list { padding-left: 20px; margin-bottom: 36px; color: var(--ink-dim); font-size: 13.5px; line-height: 1.8; }

  .faq-card { border: 1px solid var(--panel-border); border-radius: 10px; overflow: hidden; }
  .faq-item { border-top: 1px solid var(--panel-border); }
  .faq-item:first-child { border-top: none; }
  .faq-item summary { padding: 14px 16px; font-size: 13px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .faq-item summary::marker { color: var(--ink-faint); }
  .faq-item p { padding: 0 16px 16px; font-size: 13px; color: var(--ink-dim); line-height: 1.6; margin: 0; }
</style>
