---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import RelatedTools from '../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import DpiCalculator from '../components/react/dpi/DpiCalculator.jsx'
import FaqSchema from '../components/astro/FaqSchema.astro'

const title = 'DPI / PPI Print Size Calculator — Free Online Tool | Rocking Tools'
const description = 'Find out what print size your image resolution supports, or how many pixels you need for a target print size at a given DPI/PPI.'
const keywords = 'dpi calculator, ppi calculator, print size calculator, pixels to inches calculator, image resolution for print, 300 dpi calculator'

const faqItems = [
  { q: 'What is the difference between DPI and PPI?', a: 'DPI (Dots Per Inch) refers to printer ink density, while PPI (Pixels Per Inch) refers to digital display or image resolution.' },
  { q: 'What DPI is required for high quality printing?', a: '300 DPI is the industry standard for sharp, high-quality physical prints, fine art, and photo publishing.' },
  { q: 'How do I calculate pixel resolution from physical print size?', a: 'Multiply the desired print width and height in inches by the target DPI. For example, an 8x10 inch print at 300 DPI requires 2400 x 3000 pixels.' }
]
---

<BaseLayout title={title} description={description} path="/dpi-calculator" keywords={keywords}>
  <SoftwareApplicationSchema slot="head" name="DPI / PPI Print Size Calculator" description={description} path="/dpi-calculator" />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'DPI Calculator' }]} />

  <div class="tool-hero">
    <h1>DPI / PPI Print Size Calculator</h1>
    <p>Figure out what print size your image supports, or how many pixels you need to hit a target print size and quality.</p>
  </div>

  <DpiCalculator client:only="react" />

  <article class="tool-guide">
    <h2>Understanding DPI, PPI, and Print Resolution</h2>
    <p>When preparing images for physical printing or digital displays, resolution is measured in dots per inch (DPI) or pixels per inch (PPI). Higher DPI/PPI produces sharper detail and smoother gradients.</p>
    
    <h3>Common Print Resolution Standards</h3>
    <ul>
      <li><strong>300 DPI:</strong> Professional photo printing, brochures, books, and fine art prints.</li>
      <li><strong>150–200 DPI:</strong> Posters, magazines, and medium-distance viewing graphics.</li>
      <li><strong>72–96 DPI:</strong> Standard screen displays and web graphics (not recommended for printing).</li>
    </ul>

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentSlug="/dpi-calculator" />
</BaseLayout>

<style>
  .tool-hero { max-width: 720px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 0; }
</style>
