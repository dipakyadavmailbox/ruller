---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import RelatedTools from '../../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../../components/astro/SoftwareApplicationSchema.astro'
import DpiCalculator from '../../components/react/dpi/DpiCalculator.jsx'
import FaqSchema from '../../components/astro/FaqSchema.astro'
import PrivacyComparisonTable from '../../components/astro/PrivacyComparisonTable.astro'
import AdUnit from '../../components/astro/AdUnit.astro'

const title = 'DPI / PPI Print Size Calculator — Free Online Tool | Rocking Tools'
const description = 'Free DPI & PPI print size calculator. Find the maximum print size your image supports at 300 DPI, or calculate how many pixels you need for a target print size. Works for photos, posters, canvas prints, and business cards.'
const keywords = 'dpi calculator, ppi calculator, print size calculator, pixels to inches calculator, image resolution for print, 300 dpi calculator, how many pixels do i need to print, dpi to print size'

const faqItems = [
  { q: 'What is the difference between DPI and PPI?', a: 'DPI (Dots Per Inch) refers to printer ink dot density — how many physical ink dots a printer places per inch. PPI (Pixels Per Inch) refers to digital image or screen resolution. For print preparation, you work in PPI for your image file, and the printer\'s DPI determines how sharply those pixels are reproduced on paper.' },
  { q: 'What DPI is required for high quality photo printing?', a: '300 DPI is the industry standard for sharp, high-quality physical prints, fine art, and photo books. Images below 150 DPI will appear noticeably blurry at normal viewing distances. For large-format prints viewed from more than 1 metre away, 100–150 DPI is acceptable.' },
  { q: 'How do I calculate pixel resolution from physical print size?', a: 'Multiply the desired print width and height in inches by the target DPI. For example, an 8×10 inch print at 300 DPI requires 2400 × 3000 pixels minimum. For a 20×24 inch poster at 150 DPI you need 3000 × 3600 pixels.' },
  { q: 'Can I upscale a low-resolution image for printing?', a: 'Software upscaling (Photoshop, Topaz Gigapixel AI) can improve low-resolution images, but it cannot recover detail that was never captured. A 72 DPI web image upscaled to 300 DPI for a 4×6 inch print will always be softer than a natively high-resolution photo. Use this calculator to know the true maximum print size before upscaling.' },
  { q: 'What resolution should I export for social media?', a: 'Social media platforms display images at 72–96 PPI. For Instagram, export at 1080 × 1080 px (square), 1080 × 1350 px (portrait), or 1080 × 608 px (landscape). For Twitter/X, use 1200 × 675 px for landscape. These are screen resolutions — DPI does not matter for digital display.' },
  { q: 'How many megapixels do I need to print A3 at 300 DPI?', a: 'An A3 sheet is 11.7 × 16.5 inches. At 300 DPI you need 3510 × 4950 pixels = approximately 17.4 megapixels. A modern 20+ megapixel camera can produce excellent A3 prints.' },
]
---

<BaseLayout title={title} description={description} path="/dpi-calculator" keywords={keywords}>
  <SoftwareApplicationSchema slot="head" name="DPI / PPI Print Size Calculator" description={description} path="/dpi-calculator" />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'DPI Calculator' }]} />

  <div class="tool-hero">
    <h1>DPI / PPI Print Size Calculator</h1>
    <p>Figure out what print size your image supports, or how many pixels you need to hit a target print size and quality.</p>
    <img
      src="/og/dpi-calculator.png"
      alt="DPI and PPI print size calculator showing pixel dimensions and print resolution"
      class="tool-preview-img"
      width="1200"
      height="630"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <DpiCalculator client:load />

  <AdUnit placement="inArticle" />

  <article class="tool-guide">
    <h2>Understanding DPI, PPI, and Print Resolution</h2>
    <p>When preparing images for physical printing or digital displays, resolution is measured in dots per inch (DPI) or pixels per inch (PPI). Higher DPI/PPI produces sharper detail and smoother gradients. Knowing the relationship between pixel dimensions and print size is essential for photographers, graphic designers, and anyone ordering prints.</p>

    <p>Use this calculator in two modes: enter your <strong>image pixel dimensions</strong> to find the maximum print size at a given DPI, or enter a <strong>target print size</strong> to find how many pixels you need.</p>

    <h3>Common Print Resolution Standards</h3>
    <ul>
      <li><strong>300 DPI:</strong> Professional photo printing, brochures, books, business cards, and fine art prints. Use this for anything viewed at hand-distance.</li>
      <li><strong>200–250 DPI:</strong> Magazines, packaging, and medium-format posters. Acceptable for casual photo prints.</li>
      <li><strong>150 DPI:</strong> Large-format posters and banners viewed from 1+ metre away. Canvas wraps and trade show graphics.</li>
      <li><strong>72–96 DPI:</strong> Standard screen display and web graphics. Not suitable for any physical printing.</li>
    </ul>

    <h3>Popular Print Sizing & DPI Calculators</h3>
    <p>Jump directly to standard photo frame sizes and resolution calculators:</p>
    <div class="dpi-subtools-grid">
      <a href="/dpi-calculator/300-dpi" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">🖨️</span><strong>300 DPI Calculator</strong><span class="dpi-tag">Photo Lab</span></div>
        <p>Standard high-quality photo lab resolution for gallery prints and albums.</p>
      </a>
      <a href="/dpi-calculator/150-dpi" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">🖼️</span><strong>150 DPI Large Format</strong><span class="dpi-tag">Poster/Canvas</span></div>
        <p>Optimal resolution for wall posters and canvas prints viewed from 3+ feet.</p>
      </a>
      <a href="/dpi-calculator/4x6-print" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">📷</span><strong>4×6 Photo Print Size</strong><span class="dpi-tag">1200×1800 px</span></div>
        <p>Exact pixel dimensions for standard 4×6 photo album prints at 300 DPI.</p>
      </a>
      <a href="/dpi-calculator/5x7-print" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">🖼️</span><strong>5×7 Framed Print Size</strong><span class="dpi-tag">1500×2100 px</span></div>
        <p>Pixel requirements for senior portraits, wedding frames, and invitations.</p>
      </a>
      <a href="/dpi-calculator/8x10-print" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">🖼️</span><strong>8×10 Photo Frame Size</strong><span class="dpi-tag">2400×3000 px</span></div>
        <p>Pixel resolution for standard 8×10 inch portrait frames and wall art.</p>
      </a>
      <a href="/dpi-calculator/a4-print" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">📄</span><strong>A4 Sheet in Pixels</strong><span class="dpi-tag">2480×3508 px</span></div>
        <p>International standard ISO 216 A4 paper resolution at 300, 150, and 72 DPI.</p>
      </a>
      <a href="/dpi-calculator/poster-size" class="dpi-subtool-card">
        <div class="dpi-card-header"><span class="dpi-card-icon">🎬</span><strong>24×36 Poster Size</strong><span class="dpi-tag">3600×5400 px</span></div>
        <p>Full-size movie, theatrical, and concert poster resolution calculator.</p>
      </a>
    </div>

    <PrivacyComparisonTable toolName="DPI & Print Resolution Calculation" competitorLabel="Other Resolution Calculators" />

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <AdUnit placement="belowTool" />

  <RelatedTools currentSlug="/dpi-calculator" />
</BaseLayout>

<style>
  .tool-hero { max-width: 780px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .tool-preview-img { width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 24px; display: block; object-fit: cover; }

  .dpi-subtools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin: 20px 0 32px;
  }
  .dpi-subtool-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    text-decoration: none;
    transition: all 150ms ease;
  }
  .dpi-subtool-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }
  .dpi-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .dpi-card-icon { font-size: 18px; }
  .dpi-card-header strong {
    font-size: 14px;
    color: var(--ink);
    flex: 1;
  }
  .dpi-tag {
    font-size: 10.5px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent);
    background: var(--accent-light);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .dpi-subtool-card p {
    font-size: 12.5px;
    color: var(--ink-dim);
    line-height: 1.5;
    margin: 0;
  }
</style>
