---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import { SITE_CONFIG } from '../../siteConfig.js'

const title = 'Frequently Asked Questions — Rocking Tools'
const description = 'Find answers to common questions about all Rocking Tools — Screen Ruler, DPI Calculator, Image Resizer, Password Checker, Calorie Calculator, Pregnancy Calculator, Regex Tester, Cron Builder, and Data Converter.'
const keywords = 'rocking tools faq, screen ruler help, dpi calculator questions, image resizer faq, password checker faq, calorie calculator help, pregnancy calculator faq, regex tester guide, cron expression help, data converter faq, free browser tools'

const faqCategories = [
  {
    id: 'general',
    icon: '✨',
    label: 'General',
    heading: 'General Questions',
    color: '#6366f1',
    items: [
      {
        q: 'What is Rocking Tools?',
        a: 'Rocking Tools is a curated studio of single-purpose, high-precision browser utilities for design, security, health, and development. Every tool runs entirely in your browser — nothing is uploaded to any server, and no account is ever required.',
      },
      {
        q: 'Are all tools completely free?',
        a: 'Yes. Every tool on Rocking Tools is 100% free to use, with no hidden fees, subscriptions, or paywalls. We are community-supported through optional donations.',
      },
      {
        q: 'Do I need to create an account or sign up?',
        a: 'No. Zero sign-up. Zero login. Every tool works immediately in your browser without any registration.',
      },
      {
        q: 'Is my data private and secure?',
        a: 'Absolutely. All computation happens client-side in your browser using JavaScript. No data — passwords, images, files, measurements, or health information — is ever sent to our servers. Your data never leaves your device.',
      },
      {
        q: 'Does Rocking Tools work offline?',
        a: 'Once the page has loaded, most tools work fully offline. The computation is local — you just need the initial page load, after which an internet connection is not required for the calculations themselves.',
      },
      {
        q: 'Which browsers are supported?',
        a: 'Rocking Tools supports all modern browsers: Chrome, Firefox, Edge, Safari, and Opera on both desktop and mobile. We recommend keeping your browser up-to-date for the best experience.',
      },
      {
        q: 'How do I report a bug or suggest a new tool?',
        a: 'Use the Contact page to send us a message. We read every message and prioritize bug fixes. Feature requests are tracked and the most-requested ones get built first.',
      },
    ],
  },
  {
    id: 'design-photography',
    icon: '🎨',
    label: 'Design & Photography',
    heading: 'Design & Photography Tools',
    color: '#06b6d4',
    items: [
      {
        q: 'How does the Screen Ruler work?',
        a: 'The Screen Ruler measures real-world physical dimensions (millimetres, centimetres, or inches) directly on your screen. It uses your monitor diagonal screen size to calculate the exact pixels-per-inch (PPI) of your display and renders a ruler at true physical scale. No calibration image or physical reference is needed.',
      },
      {
        q: 'Why does the Screen Ruler need my monitor size?',
        a: 'The ruler must know your screen physical pixel density (PPI) to convert digital pixels to real-world millimetres or inches. Without the screen size, it cannot determine how many physical millimetres each pixel represents.',
      },
      {
        q: 'Can I use the Screen Ruler on a phone or tablet?',
        a: 'Yes. The ruler works on any device with a known screen size. For phones or tablets, simply enter the diagonal screen size in the prompt (e.g. 6.1 inches for an iPhone 13) and the ruler will calibrate accurately.',
      },
      {
        q: 'What does the Aspect Ratio Calculator do?',
        a: 'It calculates matching width and height pairs for any aspect ratio (16:9, 4:5, 1:1, 9:16, etc.) and can also calculate the exact crop box needed to center-crop an image from one ratio to another. It is useful for social media images, video thumbnails, and print layouts.',
      },
      {
        q: 'How is DPI different from PPI?',
        a: 'PPI (Pixels Per Inch) refers to digital screen resolution. DPI (Dots Per Inch) refers to printer resolution. The DPI/PPI Print Size Calculator uses the pixel dimensions of your image and your desired print quality (e.g. 300 DPI) to tell you the maximum physical print size achievable without losing quality.',
      },
      {
        q: 'What DPI should I use for professional printing?',
        a: '300 DPI is the standard for professional-quality print such as photos, flyers, and business cards. 150 DPI is acceptable for large-format prints viewed from a distance like banners and posters. 72 to 96 DPI is screen resolution and is not suitable for print.',
      },
      {
        q: 'Is my image uploaded when using the Image Compressor and Resizer?',
        a: 'Your image is never uploaded anywhere. The Image Compressor and Resizer uses the browser built-in Canvas API to compress and resize images entirely in memory on your device. The processed image is then downloaded directly from your browser.',
      },
      {
        q: 'What image formats does the Image Resizer support?',
        a: 'The tool supports JPEG, PNG, WebP, and GIF as input formats. You can export as JPEG or PNG. WebP output is available in browsers that support it such as Chrome, Edge, and Firefox. For best compression ratios, WebP is recommended.',
      },
    ],
  },
  {
    id: 'security-health',
    icon: '🔒',
    label: 'Security & Health',
    heading: 'Security & Health Tools',
    color: '#10b981',
    items: [
      {
        q: 'Is it safe to type my real password into the Password Checker?',
        a: 'Yes. The Password Strength Checker operates 100% client-side in your browser. Your password is never sent over the network, never logged, and never stored. You can verify this by opening your browser DevTools Network tab — you will see zero requests made when you type.',
      },
      {
        q: 'How is password strength calculated?',
        a: 'Strength is calculated using Shannon entropy — a measure of randomness based on the character set size (lowercase, uppercase, numbers, symbols) and password length. A higher entropy means more possible combinations and a longer crack time.',
      },
      {
        q: 'What is a good password entropy score?',
        a: 'Anything above 60 bits of entropy is considered strong. 80 or more bits is very strong. A 16-character truly random password using mixed case, numbers, and symbols typically achieves 100 or more bits of entropy.',
      },
      {
        q: 'How accurate is the time to crack estimate?',
        a: 'It is an estimate based on modern GPU brute-force attack speeds (approximately 10 billion guesses per second for bcrypt). Real-world times vary based on hashing algorithm, hardware, and attack methodology. Use it as a relative comparison, not an absolute guarantee.',
      },
      {
        q: 'How does the Calorie Calculator work?',
        a: 'The Calorie Calculator uses the Mifflin-St Jeor equation, the most widely validated formula, to estimate your Basal Metabolic Rate (BMR). It then multiplies by your activity level multiplier to find your Total Daily Energy Expenditure (TDEE) — the number of calories you burn per day.',
      },
      {
        q: 'What are macros and how are they split?',
        a: 'Macronutrients are protein, carbohydrates, and fat — the three major sources of food energy. The suggested macro split is based on common dietary guidelines: approximately 30 percent protein, 40 percent carbohydrates, and 30 percent fat, adjusted for your goal of deficit, maintenance, or surplus.',
      },
      {
        q: 'How accurate is the Pregnancy Due Date Calculator?',
        a: 'The due date is estimated using Naegele Rule, the standard obstetric formula: Last Menstrual Period date plus 280 days (40 weeks). This is the same calculation used by most healthcare providers and is accurate within a 2-week window. It is not a medical diagnosis — always confirm with your OB/GYN.',
      },
      {
        q: 'How does the Ovulation and Fertile Window Calculator work?',
        a: 'Ovulation typically occurs 14 days before the next menstrual period. The fertile window is approximately the 5 days before ovulation plus ovulation day itself. Enter your last period date and average cycle length, and the tool calculates these windows for you.',
      },
      {
        q: 'Is my health data stored or shared?',
        a: 'No. All health calculations — calorie needs, pregnancy dates, ovulation windows — run entirely in your browser and are never sent to any server. We collect zero personal health data.',
      },
    ],
  },
  {
    id: 'developer-tools',
    icon: '⚡',
    label: 'Developer Tools',
    heading: 'Developer Tools',
    color: '#f59e0b',
    items: [
      {
        q: 'What is a regular expression (regex)?',
        a: 'A regular expression is a sequence of characters that forms a search pattern. It is used to match, find, or replace strings in text. Regex is supported in virtually every programming language including JavaScript, Python, Java, PHP, and Go, and is essential for input validation, log parsing, and text transformation.',
      },
      {
        q: 'How do I use the Regex Tester?',
        a: 'Enter your regular expression pattern in the Pattern field and your test string in the Test String field. The tool will highlight all matches in real time, show you each capture group value, and indicate any syntax errors in the pattern. You can also use the built-in cheatsheet for quick reference.',
      },
      {
        q: 'What regex flags are supported in the Regex Tester?',
        a: 'The Regex Tester supports the standard JavaScript regex flags: g (global — find all matches), i (case-insensitive), m (multiline — caret and dollar match line boundaries), and s (dotAll — dot matches newlines).',
      },
      {
        q: 'What is a cron expression?',
        a: 'A cron expression is a string of five or six fields separated by spaces that defines a recurring schedule. It is used by Unix/Linux cron jobs, CI/CD pipelines such as GitHub Actions and GitLab CI, cloud schedulers like AWS EventBridge and GCP Cloud Scheduler, and application schedulers like node-cron to trigger tasks automatically.',
      },
      {
        q: 'What does the Cron Expression Builder do?',
        a: 'It provides a visual builder where you set minutes, hours, days, months, and weekdays using dropdowns and inputs — then generates the correct cron string for you. It also parses existing cron strings into human-readable English explanations and shows the next execution timestamps.',
      },
      {
        q: 'What is the difference between 5-field and 6-field cron?',
        a: 'Standard Unix cron uses 5 fields: minute, hour, day-of-month, month, and day-of-week. Some schedulers such as Quartz and Spring use 6 fields with an additional seconds field at the start. The Cron Builder supports both formats.',
      },
      {
        q: 'What formats does the Data Converter support?',
        a: 'The JSON to CSV to YAML Converter supports bidirectional conversion between all three formats: JSON (JavaScript Object Notation), CSV (Comma-Separated Values), and YAML (YAML Ain\'t Markup Language). Paste your data in any format and click the target format to convert instantly.',
      },
      {
        q: 'Is there a file size limit for the Data Converter?',
        a: 'There is no hard limit imposed by the tool — the limit is your browser available memory. The converter handles large datasets such as thousands of rows of CSV or megabytes of JSON efficiently since all processing is done in-memory using JavaScript.',
      },
      {
        q: 'Can I convert nested JSON to CSV?',
        a: 'The converter flattens nested JSON objects into CSV columns using dot-notation keys, for example address.city. Deeply nested arrays within rows may be serialised as JSON strings in the corresponding CSV cell. For complex nested structures, YAML is often a better export format as it preserves hierarchy.',
      },
    ],
  },
]

const allFaqItems = faqCategories.flatMap((cat) => cat.items)

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE_CONFIG.domain}/faq` },
  ],
}
---

<BaseLayout
  title={title}
  description={description}
  path="/faq"
  keywords={keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'FAQ' }]} />

  <div class="faq-hero">
    <div class="hero-badge">❓ HELP CENTER</div>
    <h1>Frequently Asked <span class="gradient-text">Questions</span></h1>
    <p class="hero-desc">
      Everything you need to know about Rocking Tools — organized by category.
      Can't find your answer? <a href="/contact" class="accent-link">Contact us</a>.
    </p>

    <nav class="cat-nav" aria-label="FAQ categories">
      {faqCategories.map((cat) => (
        <a href={`#${cat.id}`} class="cat-pill" data-color={cat.color}>
          <span aria-hidden="true">{cat.icon}</span>
          <span>{cat.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="faq-page">
    {faqCategories.map((cat, catIdx) => (
      <section class="faq-section" id={cat.id} aria-labelledby={`cat-heading-${catIdx}`}>
        <div class="section-header">
          <div class="section-icon" data-color={cat.color}>
            <span aria-hidden="true">{cat.icon}</span>
          </div>
          <div>
            <h2 id={`cat-heading-${catIdx}`} class="section-title">{cat.heading}</h2>
            <p class="section-count">{cat.items.length} questions</p>
          </div>
        </div>

        <div class="accordion-list" role="list">
          {cat.items.map((item, idx) => (
            <div class="accordion-item" role="listitem">
              <button
                class="accordion-trigger"
                aria-expanded="false"
                aria-controls={`faq-answer-${catIdx}-${idx}`}
                id={`faq-question-${catIdx}-${idx}`}
                type="button"
              >
                <span class="q-number" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                <span class="q-text">{item.q}</span>
                <span class="chevron" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
              <div
                class="accordion-answer"
                id={`faq-answer-${catIdx}-${idx}`}
                role="region"
                aria-labelledby={`faq-question-${catIdx}-${idx}`}
                hidden
              >
                <p>{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="cta-block">
      <div class="cta-icon" aria-hidden="true">💬</div>
      <h2 class="cta-title">Still have questions?</h2>
      <p class="cta-desc">Our team reads every message. Reach out and we will get back to you as quickly as possible.</p>
      <a href="/contact" class="cta-btn">Contact Support</a>
    </div>
  </div>
</BaseLayout>

<style>
  .faq-hero {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 20px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 20px;
    background: var(--accent-light);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
  }
  h1 {
    font-size: clamp(30px, 5vw, 48px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-desc {
    font-size: clamp(14px, 2vw, 16px);
    color: var(--ink-dim);
    line-height: 1.65;
    max-width: 600px;
    margin: 0;
  }
  .accent-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 18px;
    border-radius: 100px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    color: var(--ink-dim);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 180ms ease;
    backdrop-filter: var(--glass-backdrop);
  }
  .cat-pill:hover {
    color: var(--ink);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .faq-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 20px 80px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .faq-section {
    scroll-margin-top: 90px;
  }
  .section-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .section-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 14px;
    border: 1px solid var(--panel-border);
    background: var(--panel-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .section-title {
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 2px;
  }
  .section-count {
    font-size: 12px;
    color: var(--ink-faint);
    font-weight: 600;
    margin: 0;
  }

  .accordion-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--panel-bg);
    backdrop-filter: var(--glass-backdrop);
  }
  .accordion-item {
    border-bottom: 1px solid var(--panel-border);
  }
  .accordion-item:last-child {
    border-bottom: none;
  }
  .accordion-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    color: var(--ink);
    transition: background 150ms ease;
  }
  .accordion-trigger:hover {
    background: var(--panel-hover);
  }
  .accordion-trigger[aria-expanded='true'] {
    background: var(--panel-hover);
  }
  .accordion-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }
  .q-number {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
    min-width: 24px;
    opacity: 0.7;
  }
  .q-text {
    flex: 1;
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.45;
  }
  .chevron {
    flex-shrink: 0;
    color: var(--ink-faint);
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
  }
  .accordion-answer {
    padding: 0 22px 20px calc(22px + 14px + 24px);
    animation: slideDown 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-answer[hidden] {
    display: none;
  }
  .accordion-answer p {
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.75;
    margin: 0;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cta-block {
    text-align: center;
    padding: 48px 32px;
    border-radius: 20px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    box-shadow: var(--shadow-lg);
  }
  .cta-icon { font-size: 36px; }
  .cta-title {
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }
  .cta-desc {
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.65;
    max-width: 420px;
    margin: 0;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    margin-top: 8px;
    transition: all 180ms ease;
    box-shadow: 0 4px 20px -4px rgba(99, 102, 241, 0.45);
  }
  .cta-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px -4px rgba(99, 102, 241, 0.6);
  }

  @media (max-width: 600px) {
    .faq-hero { padding: 36px 16px 28px; }
    .faq-page { padding: 0 16px 60px; gap: 40px; }
    .accordion-trigger { padding: 16px; gap: 10px; }
    .accordion-answer { padding: 0 16px 16px 50px; }
    .q-text { font-size: 13.5px; }
    .cta-block { padding: 32px 20px; }
    .section-icon { width: 40px; height: 40px; font-size: 18px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.accordion-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true'
      const answerId = btn.getAttribute('aria-controls')
      const answer = answerId ? document.getElementById(answerId) : null
      if (!answer) return
      btn.setAttribute('aria-expanded', String(!isExpanded))
      answer.hidden = isExpanded
    })
  })
</script>
