---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import RelatedTools from '../../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../../components/astro/SoftwareApplicationSchema.astro'
import FaqSchema from '../../components/astro/FaqSchema.astro'
import ImageResizer from '../../components/react/imagetool/ImageResizer.jsx'
import { IMAGE_RESIZER_PRESETS, getImageResizerPreset } from '../../data/imageResizerPagesData.js'

export function getStaticPaths() {
  return IMAGE_RESIZER_PRESETS.map((p) => ({
    params: { preset: p.slug },
  }))
}

const { preset: slugParam } = Astro.params
const presetData = getImageResizerPreset(slugParam) || IMAGE_RESIZER_PRESETS[0]

const title = presetData.title
const description = presetData.description
const keywords = presetData.keywords
const canonicalPath = `/image-resizer/${presetData.slug}`

const faqItems = presetData.faqs || []

// Build related presets (other presets in the same tool)
const relatedPresets = IMAGE_RESIZER_PRESETS.filter((p) => p.slug !== presetData.slug).slice(0, 4)
---

<BaseLayout title={title} description={description} path={canonicalPath} keywords={keywords}>
  <SoftwareApplicationSchema
    slot="head"
    name={`Image Resizer — ${presetData.slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}`}
    description={description}
    path={canonicalPath}
  />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb
    items={[
      { label: 'Home', path: '/' },
      { label: 'Image Resizer', path: '/image-resizer' },
      { label: presetData.slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) },
    ]}
  />

  <div class="tool-hero">
    <h1>{presetData.slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())} Image Resizer</h1>
    <p>{presetData.intro}</p>
    {presetData.presetWidth > 0 && (
      <div class="preset-badge">
        <span class="preset-icon">📐</span>
        <span>Preset: <strong>{presetData.presetWidth} × {presetData.presetHeight} px</strong></span>
      </div>
    )}
  </div>

  <ImageResizer
    client:load
    initialWidth={presetData.presetWidth || 0}
    initialHeight={presetData.presetHeight || 0}
    initialQuality={presetData.slug === '100kb' ? 60 : 80}
  />

  <article class="tool-guide">
    <h2>Best Use Cases</h2>
    <div class="use-cases-grid">
      {presetData.useCases.map((uc) => (
        <div class="use-case-card">
          <h4>{uc.title}</h4>
          <p>{uc.desc}</p>
        </div>
      ))}
    </div>

    {faqItems.length > 0 && (
      <>
        <h2>Frequently Asked Questions</h2>
        {faqItems.map((faq) => (
          <div class="faq-item">
            <h4>{faq.q}</h4>
            <p>{faq.a}</p>
          </div>
        ))}
      </>
    )}

    <div class="related-section">
      <h2>Other Image Resizer Presets</h2>
      <div class="related-grid">
        {relatedPresets.map((p) => (
          <a href={`/image-resizer/${p.slug}`} class="related-card">
            <span>🖼️</span> {p.slug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}
          </a>
        ))}
        <a href="/image-resizer" class="related-card main-link">
          <span>⚙️</span> Main Image Resizer →
        </a>
      </div>
    </div>
  </article>

  <RelatedTools currentSlug="/image-resizer" />
</BaseLayout>

<style>
  .tool-hero { max-width: 860px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }

  .preset-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 10px;
    background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25);
    color: var(--ink); font-size: 13px; font-weight: 500; margin-bottom: 16px;
  }
  .preset-icon { font-size: 16px; }
  .preset-badge strong { color: var(--accent); font-weight: 800; font-family: var(--font-mono); }

  .tool-guide {
    max-width: 860px; margin: 40px auto; padding: 32px;
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px;
  }
  .tool-guide h2 { font-size: 20px; font-weight: 800; color: var(--ink); margin-top: 32px; margin-bottom: 12px; }
  .tool-guide h2:first-child { margin-top: 0; }

  .use-cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-bottom: 24px; }
  .use-case-card { padding: 16px; background: rgba(255,255,255,0.02); border: 1px solid var(--panel-border); border-radius: 10px; }
  .use-case-card h4 { font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .use-case-card p { font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5; }

  .faq-item { margin-bottom: 16px; }
  .faq-item h4 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
  .faq-item p { margin: 0; font-size: 14px; color: var(--ink-dim); line-height: 1.6; }

  .related-section { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--panel-border); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .related-card {
    display: flex; align-items: center; gap: 8px; padding: 10px 14px;
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 10px;
    color: var(--ink); text-decoration: none; font-size: 13px; font-weight: 600; transition: all 150ms ease;
  }
  .related-card:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
  .main-link { background: rgba(99, 102, 241, 0.08); color: var(--accent); border-color: rgba(99, 102, 241, 0.2); }
</style>
