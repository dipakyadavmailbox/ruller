---
import BaseLayout from '../layouts/BaseLayout.astro'
import ToolGrid from '../components/react/home/ToolGrid.jsx'
import { SITE_CONFIG } from '../siteConfig.js'

const title = 'Rocking Tools — Free, Private Online Tools & Utilities'
const description = 'Studio-grade browser utilities for image processing, PDF editing, developer formatting, calculations, and security. 100% private, client-side, zero signup.'

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.siteName,
  url: SITE_CONFIG.domain,
  description: description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_CONFIG.domain}/sitemap?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
}

// SiteNavigationElement Schema - Crucial for Google Sitelinks generation
const sitelinksSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'Online Screen Ruler',
    url: `${SITE_CONFIG.domain}/ruler`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'DPI & PPI Print Size Calculator',
    url: `${SITE_CONFIG.domain}/dpi-calculator`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'Password Strength Checker & Generator',
    url: `${SITE_CONFIG.domain}/password-checker`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'Calorie & TDEE Calculator',
    url: `${SITE_CONFIG.domain}/calorie-calculator`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'Image Resizer & Compressor',
    url: `${SITE_CONFIG.domain}/image-resizer`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SiteNavigationElement',
    name: 'Regex Tester & Debugger',
    url: `${SITE_CONFIG.domain}/regex-tester`,
  },
]

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Rocking Tools Free Browser Utilities',
  description: 'Single-purpose high-precision client-side browser tools',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Online Screen Ruler', url: `${SITE_CONFIG.domain}/ruler` },
    { '@type': 'ListItem', position: 2, name: 'DPI / PPI Print Size Calculator', url: `${SITE_CONFIG.domain}/dpi-calculator` },
    { '@type': 'ListItem', position: 3, name: 'Image Compressor & Resizer', url: `${SITE_CONFIG.domain}/image-resizer` },
    { '@type': 'ListItem', position: 4, name: 'Aspect Ratio Calculator', url: `${SITE_CONFIG.domain}/aspect-ratio-calculator` },
    { '@type': 'ListItem', position: 5, name: 'Password Strength Checker', url: `${SITE_CONFIG.domain}/password-checker` },
    { '@type': 'ListItem', position: 6, name: 'Calorie & TDEE Calculator', url: `${SITE_CONFIG.domain}/calorie-calculator` },
    { '@type': 'ListItem', position: 7, name: 'Pregnancy Due Date Calculator', url: `${SITE_CONFIG.domain}/pregnancy-calculator` },
    { '@type': 'ListItem', position: 8, name: 'Regex Tester', url: `${SITE_CONFIG.domain}/regex-tester` },
    { '@type': 'ListItem', position: 9, name: 'Cron Expression Builder', url: `${SITE_CONFIG.domain}/cron-expression-builder` },
    { '@type': 'ListItem', position: 10, name: 'Data Format Converter', url: `${SITE_CONFIG.domain}/data-converter` },
    { '@type': 'ListItem', position: 11, name: 'QR Code Generator', url: `${SITE_CONFIG.domain}/qr-code-generator` },
    { '@type': 'ListItem', position: 12, name: 'PDF Converter, Merger & Splitter', url: `${SITE_CONFIG.domain}/pdf-tools` },
    { '@type': 'ListItem', position: 13, name: 'Color Picker & Palette Generator', url: `${SITE_CONFIG.domain}/color-tools` },
    { '@type': 'ListItem', position: 14, name: 'Unit Converter', url: `${SITE_CONFIG.domain}/unit-converter` },
  ],
}
---

<BaseLayout 
  title={title} 
  description={description} 
  path="/"
  keywords="free online tools, browser tools, developer utilities, screen ruler, dpi calculator, calorie calculator, pregnancy calculator, regex tester, cron builder, aspect ratio calculator, qr code generator, private web utilities"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(sitelinksSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <div class="hero-section">
    <div class="badge-pill">✨ 100% FREE &amp; PRIVATE BROWSER UTILITIES</div>
    <h1>High-Precision Tools.<br /><span class="gradient-text">Zero Signup. Instant Results.</span></h1>
    <p class="hero-sub">
      Single-purpose browser utilities engineered for extreme speed and precision. 
      Your data is processed locally in your browser and never leaves your device.
    </p>

    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-num">10+</span>
        <span class="stat-label">Studio Tools</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">0ms</span>
        <span class="stat-label">Server Latency</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Client-Side Private</span>
      </div>
    </div>
  </div>

  <ToolGrid client:load />

  {/* Comprehensive static tool directory for search engines and user discovery */}
  <section aria-label="All Tools & Utilities Directory" class="seo-tool-directory">
    <div class="dir-header">
      <span class="dir-badge">EXPLORE DIRECTORY</span>
      <h2>All Free Online Tools &amp; Specialized Utilities</h2>
      <p class="dir-intro">Studio-grade client-side utilities engineered for zero latency, 100% data privacy, and exact mathematical precision.</p>
    </div>

    <div class="dir-category-grid">
      <!-- Media & Graphics -->
      <div class="dir-cat-card">
        <div class="dir-cat-title"><span class="cat-icon">🖼️</span><h3>Image &amp; Display Tools</h3></div>
        <ul class="dir-links-list">
          <li><a href="/image-resizer"><strong>Image Resizer &amp; Compressor</strong> — WebP, PNG, JPG optimizer</a></li>
          <li><a href="/image-resizer/passport-photo">Passport Photo Resizer (2×2 in / 600×600 px)</a></li>
          <li><a href="/image-resizer/instagram">Instagram Post &amp; Story Dimensions</a></li>
          <li><a href="/dpi-calculator"><strong>DPI &amp; PPI Print Calculator</strong> — Pixel to print sizing</a></li>
          <li><a href="/dpi-calculator/300-dpi">300 DPI Photo Resolution Checker</a></li>
          <li><a href="/aspect-ratio-calculator"><strong>Aspect Ratio Calculator</strong> — Dimension cropper</a></li>
          <li><a href="/aspect-ratio/16-9">16:9 Widescreen &amp; 9:16 Vertical Video</a></li>
          <li><a href="/ruler"><strong>Online Screen Ruler</strong> — 1:1 true scale physical ruler</a></li>
          <li><a href="/color-tools"><strong>Color Picker &amp; Palette Generator</strong> — HEX, RGB, HSL</a></li>
        </ul>
      </div>

      <!-- Developer & DevOps -->
      <div class="dir-cat-card">
        <div class="dir-cat-title"><span class="cat-icon">⚡</span><h3>Developer &amp; Security Tools</h3></div>
        <ul class="dir-links-list">
          <li><a href="/regex-tester"><strong>Regex Tester &amp; Cheatsheet</strong> — Real-time highlighter</a></li>
          <li><a href="/regex-tester/email-regex">Email Validation Regex Pattern</a></li>
          <li><a href="/regex-tester/phone-number-regex">Phone Number Regex Pattern</a></li>
          <li><a href="/cron-expression-builder"><strong>Cron Expression Builder</strong> — Schedule generator</a></li>
          <li><a href="/cron-expression-builder/every-5-minutes">Every 5 Minutes Cron Schedule</a></li>
          <li><a href="/password-checker"><strong>Password Strength Tester</strong> — Entropy &amp; crack time</a></li>
          <li><a href="/password-checker/strong-password-generator">24-Char Strong Password Generator</a></li>
          <li><a href="/data-converter"><strong>JSON ⇄ CSV ⇄ YAML Converter</strong> — Table &amp; config parser</a></li>
          <li><a href="/data-converter/json-to-csv">JSON to CSV Converter for Excel</a></li>
          <li><a href="/data-converter/jwt-decoder">JWT Token &amp; Claims Decoder</a></li>
          <li><a href="/qr-code-generator"><strong>QR Code Generator</strong> — PNG, SVG, Wi-Fi &amp; vCard</a></li>
        </ul>
      </div>

      <!-- Document & PDF -->
      <div class="dir-cat-card">
        <div class="dir-cat-title"><span class="cat-icon">📄</span><h3>Document &amp; PDF Tools</h3></div>
        <ul class="dir-links-list">
          <li><a href="/pdf-tools"><strong>PDF Tools Suite</strong> — 100% private browser processing</a></li>
          <li><a href="/pdf-tools/merge-pdf">Merge Multiple PDFs into One Document</a></li>
          <li><a href="/pdf-tools/split-pdf">Split &amp; Extract PDF Pages</a></li>
          <li><a href="/pdf-tools/image-to-pdf">Images to PDF Converter (JPG &amp; PNG)</a></li>
          <li><a href="/workspace"><strong>Multi-Tool Workspace</strong> — Run tools side-by-side</a></li>
        </ul>
      </div>

      <!-- Health & Scientific -->
      <div class="dir-cat-card">
        <div class="dir-cat-title"><span class="cat-icon">🥗</span><h3>Health, Nutrition &amp; Science</h3></div>
        <ul class="dir-links-list">
          <li><a href="/calorie-calculator"><strong>Calorie &amp; TDEE Calculator</strong> — Mifflin-St Jeor daily burn</a></li>
          <li><a href="/bmr-calculator">BMR (Basal Metabolic Rate) Calculator</a></li>
          <li><a href="/calorie-deficit-calculator">Calorie Deficit Target for Fat Loss</a></li>
          <li><a href="/macro-calculator">Macro Calculator (Protein, Carbs, Fats)</a></li>
          <li><a href="/pregnancy-calculator"><strong>Pregnancy Due Date Calculator</strong> — Naegele's rule</a></li>
          <li><a href="/ovulation-calculator">Ovulation Calendar &amp; Fertile Window</a></li>
          <li><a href="/conversions"><strong>All 98+ Unit Conversions Directory</strong></a></li>
          <li><a href="/kg-to-lbs">Kilograms to Pounds (kg to lbs)</a></li>
          <li><a href="/celsius-to-fahrenheit">Celsius to Fahrenheit (°C to °F)</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    max-width: 860px;
    margin: 0 auto;
    padding: 60px 20px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 20px;
    background: var(--accent-light);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--accent);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(32px, 5.5vw, 52px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0 0 18px 0;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(15px, 2vw, 17px);
    color: var(--ink-dim);
    line-height: 1.65;
    max-width: 640px;
    margin: 0 0 36px 0;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 16px 32px;
    border-radius: 16px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    width: 100%;
    max-width: 580px;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .stat-num {
    font-size: 22px;
    font-weight: 900;
    color: var(--ink);
    font-family: var(--font-mono);
  }
  .stat-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-faint);
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: var(--panel-border);
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .hero-section {
      padding: 36px 16px 28px;
    }
    .hero-stats {
      gap: 12px;
      padding: 14px 12px;
    }
    .stat-num {
      font-size: 18px;
    }
    .stat-label {
      font-size: 10px;
    }
  }
  @media (max-width: 400px) {
    .hero-stats {
      flex-direction: column;
      gap: 12px;
      padding: 16px;
    }
    .stat-divider {
      width: 80%;
      height: 1px;
    }
  }
  /* SEO Tool Directory — visible to users and Googlebot alike */
  .seo-tool-directory {
    max-width: 1100px;
    margin: 40px auto 60px;
    padding: 40px 20px 0;
    border-top: 1px solid var(--panel-border);
  }
  .dir-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 32px;
  }
  .dir-badge {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent);
    background: var(--accent-light);
    padding: 3px 8px;
    border-radius: 6px;
    margin-bottom: 8px;
  }
  .dir-header h2 {
    font-size: clamp(20px, 3.5vw, 26px);
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 8px 0;
  }
  .dir-intro {
    font-size: 13.5px;
    color: var(--ink-dim);
    line-height: 1.5;
    margin: 0;
  }

  .dir-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .dir-cat-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
  }
  .dir-cat-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--panel-border);
  }
  .dir-cat-title .cat-icon { font-size: 20px; }
  .dir-cat-title h3 {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
  }
  .dir-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dir-links-list li a {
    font-size: 12.5px;
    color: var(--ink-dim);
    text-decoration: none;
    line-height: 1.4;
    transition: color 150ms ease;
  }
  .dir-links-list li a strong {
    color: var(--ink);
  }
  .dir-links-list li a:hover {
    color: var(--accent);
  }
  .dir-links-list li a:hover strong {
    color: var(--accent);
  }
</style>


