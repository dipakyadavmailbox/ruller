---
import BaseLayout from '../layouts/BaseLayout.astro'
import ToolGrid from '../components/react/home/ToolGrid.jsx'
import { SITE_CONFIG } from '../siteConfig.js'

const title = 'Free Online Tools — High Precision Browser Utilities | Rocking Tools'
const description = 'A curated studio collection of single-purpose, high-precision browser tools for design, security, health, and development. 100% private with zero signup.'

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.siteName,
  url: SITE_CONFIG.domain,
  description: description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_CONFIG.domain}/sitemap?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
}
---

<BaseLayout 
  title={title} 
  description={description} 
  path="/"
  keywords="free online tools, browser tools, developer utilities, screen ruler, dpi calculator, calorie calculator, pregnancy calculator, regex tester, cron builder, aspect ratio calculator"
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} slot="head" />
  <div class="hero-section">
    <div class="badge-pill">✨ 100% FREE &amp; PRIVATE BROWSER UTILITIES</div>
    <h1>High-Precision Tools.<br /><span class="gradient-text">Zero Signup. Instant Results.</span></h1>
    <p class="hero-sub">
      Single-purpose browser utilities engineered for extreme speed and precision. 
      Your data is processed locally in your browser and never leaves your device.
    </p>

    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-num">9+</span>
        <span class="stat-label">Studio Tools</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">0ms</span>
        <span class="stat-label">Server Latency</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Client-Side Private</span>
      </div>
    </div>
  </div>

  <ToolGrid client:only="react" />

  {/* Static tool links for Googlebot — ToolGrid is client:only="react" so Googlebot cannot see those links */}
  <nav aria-label="All Tools Directory" class="seo-tool-directory">
    <h2>All Free Online Tools</h2>
    <ul class="seo-tool-list">
      <li><a href="/ruler">📏 Online Screen Ruler — Measure in mm, cm & inches</a></li>
      <li><a href="/dpi-calculator">🖨️ DPI / PPI Print Size Calculator</a></li>
      <li><a href="/image-resizer">🖼️ Image Compressor & Resizer</a></li>
      <li><a href="/aspect-ratio-calculator">📐 Aspect Ratio Calculator</a></li>
      <li><a href="/password-checker">🔒 Password Strength Checker & Generator</a></li>
      <li><a href="/calorie-calculator">🥗 Calorie & TDEE Calculator</a></li>
      <li><a href="/pregnancy-calculator">🤰 Pregnancy Due Date Calculator</a></li>
      <li><a href="/regex-tester">⚙️ Regex Tester & Debugger</a></li>
      <li><a href="/cron-expression-builder">🕐 Cron Expression Builder</a></li>
      <li><a href="/data-converter">🔄 Data Format Converter</a></li>
    </ul>
  </nav>
</BaseLayout>

<style>
  .hero-section {
    max-width: 860px;
    margin: 0 auto;
    padding: 60px 20px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 20px;
    background: var(--accent-light);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: var(--accent);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(32px, 5.5vw, 52px);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0 0 18px 0;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(15px, 2vw, 17px);
    color: var(--ink-dim);
    line-height: 1.65;
    max-width: 640px;
    margin: 0 0 36px 0;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 16px 32px;
    border-radius: 16px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    backdrop-filter: var(--glass-backdrop);
    width: 100%;
    max-width: 580px;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  .stat-num {
    font-size: 22px;
    font-weight: 900;
    color: var(--ink);
    font-family: var(--font-mono);
  }
  .stat-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-faint);
    letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: var(--panel-border);
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .hero-section {
      padding: 36px 16px 28px;
    }
    .hero-stats {
      gap: 12px;
      padding: 14px 12px;
    }
    .stat-num {
      font-size: 18px;
    }
    .stat-label {
      font-size: 10px;
    }
  }
  @media (max-width: 400px) {
    .hero-stats {
      flex-direction: column;
      gap: 12px;
      padding: 16px;
    }
    .stat-divider {
      width: 80%;
      height: 1px;
    }
  }
  /* SEO Tool Directory — visible to users and Googlebot alike */
  .seo-tool-directory {
    max-width: 860px;
    margin: 0 auto 60px;
    padding: 40px 20px 0;
  }
  .seo-tool-directory h2 {
    font-size: 13px;
    font-weight: 800;
    color: var(--ink-faint);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }
  .seo-tool-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .seo-tool-list li a {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    color: var(--ink-dim);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .seo-tool-list li a:hover {
    border-color: var(--accent);
    color: var(--ink);
    background: var(--accent-light);
  }
</style>


