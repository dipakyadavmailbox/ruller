---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import RelatedTools from '../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import PasswordChecker from '../components/react/password/PasswordChecker.jsx'

const title = 'Password Strength Checker — Free, Private, No Signup | Free Tools'
const description = 'Check how strong your password is instantly, 100% in your browser — nothing is sent or stored. Includes a secure password generator.'
---

<BaseLayout title={title} description={description} path="/password-checker">
  <SoftwareApplicationSchema slot="head" name="Password Strength Checker" description={description} path="/password-checker" />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Password Strength Checker' }]} />

  <div class="tool-hero">
    <h1>Password Strength Checker</h1>
    <p>Checked entirely in your browser — your password is never sent anywhere, logged, or stored.</p>
  </div>

  <PasswordChecker client:only="react" />

  <RelatedTools currentSlug="/password-checker" />
</BaseLayout>

<style>
  .tool-hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 20px 0;
  }
  .tool-hero h1 {
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .tool-hero p {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 0;
  }
</style>
