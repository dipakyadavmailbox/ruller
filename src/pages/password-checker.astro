---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import RelatedTools from '../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import PasswordChecker from '../components/react/password/PasswordChecker.jsx'
import FaqSchema from '../components/astro/FaqSchema.astro'

const title = 'Password Strength Checker & Generator — Free, Private | Rocking Tools'
const description = 'Check how strong your password is instantly, 100% in your browser — nothing is sent or stored. Includes a secure random password generator.'
const keywords = 'password strength checker, password generator, check password security, password entropy calculator, secure password tester, private password generator'

const faqItems = [
  { q: 'Is it safe to test my password here?', a: 'Yes. All password strength calculations, entropy analysis, and random generation occur strictly in local client JavaScript. Zero network requests are made.' },
  { q: 'How is password strength and entropy calculated?', a: 'Password entropy measures randomness in bits based on character set variety (lowercase, uppercase, numbers, symbols) and length.' },
  { q: 'What makes a password strong against brute-force attacks?', a: 'Passphrases or passwords with 16+ characters combining random words or mixed character sets take centuries to crack with modern hardware.' }
]
---

<BaseLayout title={title} description={description} path="/password-checker" keywords={keywords}>
  <SoftwareApplicationSchema slot="head" name="Password Strength Checker & Generator" description={description} path="/password-checker" />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Password Strength Checker' }]} />

  <div class="tool-hero">
    <h1>Password Strength Checker & Generator</h1>
    <p>Checked entirely in your browser — your password is never sent anywhere, logged, or stored.</p>
  </div>

  <PasswordChecker client:only="react" />

  <article class="tool-guide">
    <h2>Password Security & Crack Time Analysis</h2>
    <p>Understand how cybercriminals use dictionary attacks and GPU brute-force to guess weak credentials, and how to defend your accounts.</p>

    <h3>Best Practices for Password Hygiene</h3>
    <ul>
      <li><strong>Length Over Complexity:</strong> A 20-character passphrase of random words is significantly stronger than an 8-character complex string.</li>
      <li><strong>Use a Password Manager:</strong> Generate and store unique, high-entropy passwords for every account.</li>
      <li><strong>Enable Multi-Factor Authentication (MFA):</strong> Hardware keys or authenticator apps protect accounts even if passwords leak in a data breach.</li>
    </ul>

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentSlug="/password-checker" />
</BaseLayout>

<style>
  .tool-hero {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 20px 0;
  }
  .tool-hero h1 {
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .tool-hero p {
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 0;
  }
</style>
