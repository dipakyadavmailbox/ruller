---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import RelatedTools from '../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import FaqSchema from '../components/astro/FaqSchema.astro'
import PrivacyComparisonTable from '../components/astro/PrivacyComparisonTable.astro'
import PdfTools from '../components/react/pdf/PdfTools.jsx'

const title = 'PDF Converter, Merger & Splitter — 100% Browser-Based | Rocking Tools'
const description =
  'Convert images (JPG, PNG, WebP) to PDF, merge multiple PDF files, or split/extract pages from any PDF. 100% local processing in JavaScript using pdf-lib — zero file uploads, complete privacy.'
const keywords =
  'pdf converter, merge pdf online, split pdf online, images to pdf, combine pdf files, extract pdf pages, free pdf tool, private pdf converter, browser pdf tool, jpg to pdf, png to pdf'

const faqItems = [
  {
    q: 'Are my PDF files uploaded to any server?',
    a: 'No. All PDF processing — conversion, merging, and splitting — happens entirely inside your browser using the pdf-lib JavaScript library. Your files never leave your device.',
  },
  {
    q: 'What image formats can I convert to PDF?',
    a: 'You can convert JPEG, PNG, and WebP images to a single PDF document. Each image becomes one A4 page, automatically scaled to fit with padding.',
  },
  {
    q: 'Is there a file size or page count limit?',
    a: 'There is no hard limit imposed by the tool. Processing performance depends on your device RAM and CPU. We recommend batches under 200 MB or 200 pages for smooth operation on most devices.',
  },
  {
    q: 'Can I reorder PDFs when merging?',
    a: 'Yes. The Merge tab lets you use up/down arrows to reorder the uploaded PDFs into your preferred order before merging into one file.',
  },
  {
    q: 'What does the Split tool do exactly?',
    a: 'Split extracts pages from a single PDF. In All Pages mode, each page is saved as its own PDF inside a ZIP archive. In Custom Range mode, you specify pages like "1-3, 5, 7-9" and receive a single PDF with just those pages.',
  },
  {
    q: 'Does the tool work offline?',
    a: 'Yes, once the page has fully loaded. All PDF processing is done locally in your browser — no internet connection is needed to run the tool.',
  },
]
---

<BaseLayout title={title} description={description} path="/pdf-tools" keywords={keywords}>
  <SoftwareApplicationSchema
    slot="head"
    name="PDF Converter, Merger & Splitter"
    description={description}
    path="/pdf-tools"
  />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'PDF Tools' }]} />

  <div class="tool-hero">
    <h1>PDF Converter, Merger & Splitter</h1>
    <p>
      Convert images to PDF, combine multiple PDFs into one, or extract pages. Powered by
      pdf-lib directly in your browser — zero files sent to any server.
    </p>
    <img
      src="/og/pdf-tools.png"
      alt="PDF Tools interface preview"
      class="tool-preview-img"
      width="1200"
      height="630"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <PdfTools client:load />

  <article class="tool-guide">
    <h2>Complete Guide to Browser-Based PDF Tools</h2>
    <p>
      Traditional online PDF tools upload your sensitive documents to remote cloud servers for processing.
      Rocking Tools processes everything using JavaScript directly on your device — your files stay
      100% private and never leave your computer.
    </p>

    <h3>Convert: Images to PDF</h3>
    <ul>
      <li><strong>Supported Inputs:</strong> JPEG, PNG, and WebP images (single or multiple files at once)</li>
      <li><strong>Page Sizing:</strong> Each image fills one A4 page, auto-scaled and centered with padding</li>
      <li><strong>Order Control:</strong> Use up/down arrows to set the exact page order before converting</li>
      <li><strong>WebP Support:</strong> WebP images are automatically converted via HTML5 Canvas before embedding</li>
      <li><strong>Output:</strong> A single download-ready PDF named <code>converted.pdf</code></li>
    </ul>

    <h3>Merge: Combine Multiple PDFs</h3>
    <ul>
      <li><strong>Input:</strong> Upload 2 or more PDF files at once</li>
      <li><strong>Reorder:</strong> Up/down arrows to set the final document order</li>
      <li><strong>Page Count Display:</strong> See the page count for each file and the running total</li>
      <li><strong>Output:</strong> One merged PDF with all pages in sequence, named <code>merged.pdf</code></li>
    </ul>

    <h3>Split: Extract Pages from a PDF</h3>
    <ul>
      <li><strong>Input:</strong> One PDF file (any page count)</li>
      <li><strong>All Pages Mode:</strong> Every page exported as its own PDF, bundled into a <code>.zip</code> archive</li>
      <li><strong>Custom Range Mode:</strong> Type a range like <code>1-3, 5, 7-9</code> to get exactly those pages as a single PDF</li>
      <li><strong>Output:</strong> ZIP archive (all-pages) or single PDF (range mode)</li>
    </ul>

    <PrivacyComparisonTable toolName="PDF Processing" competitorLabel="Other Online PDF Tools" />

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentSlug="/pdf-tools" />
</BaseLayout>

<style>
  .tool-hero { max-width: 900px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .tool-preview-img { width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 24px; display: block; object-fit: cover; }

  .tool-guide { max-width: 900px; margin: 0 auto; padding: 0 20px 40px; }
  .tool-guide h2 { font-size: clamp(18px, 3vw, 24px); font-weight: 800; color: var(--ink); margin: 40px 0 12px; }
  .tool-guide h3 { font-size: 16px; font-weight: 800; color: var(--ink); margin: 28px 0 10px; }
  .tool-guide p  { font-size: 14px; color: var(--ink-dim); line-height: 1.7; margin: 0 0 12px; }
  .tool-guide ul { font-size: 14px; color: var(--ink-dim); line-height: 1.7; padding-left: 20px; margin: 0 0 12px; }
  .tool-guide ul li { margin-bottom: 4px; }
  .tool-guide code { font-family: var(--font-mono); font-size: 13px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 4px; padding: 1px 6px; color: var(--accent); }

  .faq-item { margin-bottom: 20px; }
  .faq-item h4 { font-size: 14px; font-weight: 800; color: var(--ink); margin: 0 0 6px; }
  .faq-item p  { font-size: 14px; color: var(--ink-dim); line-height: 1.65; margin: 0; }
</style>
