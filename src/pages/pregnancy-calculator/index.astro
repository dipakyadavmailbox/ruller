---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import RelatedTools from '../../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../../components/astro/SoftwareApplicationSchema.astro'
import PregnancyCalculator from '../../components/react/pregnancy/PregnancyCalculator.jsx'
import FaqSchema from '../../components/astro/FaqSchema.astro'
import MedicalDisclaimer from '../../components/astro/MedicalDisclaimer.astro'
import PrivacyComparisonTable from '../../components/astro/PrivacyComparisonTable.astro'
import AdUnit from '../../components/astro/AdUnit.astro'

const title = 'Pregnancy Due Date & Ovulation Calculator — Free | Rocking Tools'
const description = 'Calculate your estimated due date, pregnancy progress by week/trimester, and fertile ovulation window based on your last menstrual period (LMP).'
const keywords = 'pregnancy due date calculator, ovulation calculator, fertile window calculator, calculate due date lmp, pregnancy week calculator, naegele rule'

const faqItems = [
  { q: 'How is the estimated due date calculated?', a: 'Due dates are typically calculated using Naegele’s Rule: add 280 days (40 weeks) to the first day of your last menstrual period (LMP).' },
  { q: 'When does ovulation occur in a menstrual cycle?', a: 'Ovulation usually happens about 14 days before your next period begins (around day 14 in a standard 28-day cycle).' },
  { q: 'How long does a normal pregnancy last?', a: 'A full-term pregnancy ranges from 37 to 42 weeks, with 40 weeks being the standard estimate.' }
]
---

<BaseLayout title={title} description={description} path="/pregnancy-calculator" keywords={keywords}>
  <SoftwareApplicationSchema slot="head" name="Pregnancy Due Date & Ovulation Calculator" description={description} path="/pregnancy-calculator" />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Pregnancy Calculator' }]} />

  <div class="tool-hero">
    <h1>Pregnancy Due Date & Ovulation Calculator</h1>
    <p>Estimate your due date, current gestational week, trimester timeline, and fertile window.</p>
    <img
      src="/og/pregnancy-calculator.png"
      alt="Pregnancy Due Date and Ovulation Calculator preview"
      class="tool-preview-img"
      width="1200"
      height="630"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <PregnancyCalculator client:load />

  <AdUnit placement="inArticle" />

  <MedicalDisclaimer topic="Pregnancy & Obstetrics" />

  <article class="tool-guide">
    <h2>Specific Pregnancy & Fertility Calculators</h2>
    <p>Jump directly to specialized obstetrics, trimester, and fertility milestone tools:</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin-bottom: 28px;">
      <a href="/due-date-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">👶</span><strong style="font-size: 14px; color: var(--ink);">Due Date Calculator</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">Naegele</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Estimate your expected delivery date using Naegele's 280-day rule from LMP.</p>
      </a>
      <a href="/ovulation-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">🌸</span><strong style="font-size: 14px; color: var(--ink);">Ovulation & Fertile Window</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">Fertility</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Identify the 6-day fertile window and peak ovulation dates for family planning.</p>
      </a>
      <a href="/conception-date-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">🗓️</span><strong style="font-size: 14px; color: var(--ink);">Conception Date</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">Estimate</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Calculate the estimated date of fertilization based on due date or cycle length.</p>
      </a>
      <a href="/pregnancy-week-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">📊</span><strong style="font-size: 14px; color: var(--ink);">Week-by-Week Progress</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">Weeks+Days</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Track your current completed gestational weeks, days, and developmental milestones.</p>
      </a>
      <a href="/pregnancy-weight-gain-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">⚖️</span><strong style="font-size: 14px; color: var(--ink);">Healthy Weight Gain</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">IOM 2009</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Target gestational weight gain ranges personalized by pre-pregnancy BMI.</p>
      </a>
      <a href="/trimester-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">📅</span><strong style="font-size: 14px; color: var(--ink);">Trimester Dates</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">1st/2nd/3rd</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Calculate exact calendar start and end dates for 1st, 2nd, and 3rd trimesters.</p>
      </a>
      <a href="/implantation-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">🩺</span><strong style="font-size: 14px; color: var(--ink);">Implantation Window</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">6-12 DPO</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Estimated embryo implantation dates and optimal days to take a home pregnancy test.</p>
      </a>
      <a href="/ivf-due-date-calculator" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">🔬</span><strong style="font-size: 14px; color: var(--ink);">IVF Due Date</strong><span style="font-size: 10px; font-weight: 700; color: var(--accent); background: var(--accent-light); padding: 2px 6px; border-radius: 6px; margin-left: auto;">FET Transfer</span></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Calculate delivery dates for 3-day and 5-day blastocyst embryo transfer cycles.</p>
      </a>
    </div>

    <h2>Understanding Pregnancy Timeline & Trimesters</h2>
    <p>Track important gestational milestones, fetal development phases, and expected delivery windows.</p>

    <h3>Trimester Breakdown</h3>
    <ul>
      <li><strong>First Trimester (Weeks 1–12):</strong> Key organ formation, initial ultrasound scans, and early pregnancy symptoms.</li>
      <li><strong>Second Trimester (Weeks 13–27):</strong> Rapid growth, movement detection, and mid-pregnancy anatomy scans.</li>
      <li><strong>Third Trimester (Weeks 28–40+):</strong> Final development, position shifting, and preparing for childbirth.</li>
    </ul>

    <PrivacyComparisonTable toolName="Pregnancy & Ovulation Calculation" competitorLabel="Other Health Apps" />

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>
  <AdUnit placement="belowTool" />


  <RelatedTools currentSlug="/pregnancy-calculator" />
</BaseLayout>

<style>
  .tool-hero { max-width: 720px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .tool-preview-img { width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 24px; display: block; object-fit: cover; }
</style>

