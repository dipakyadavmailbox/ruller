---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumb from '../../components/astro/Breadcrumb.astro'
import RelatedTools from '../../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../../components/astro/SoftwareApplicationSchema.astro'
import QrCodeGenerator from '../../components/react/qr/QrCodeGenerator.jsx'
import FaqSchema from '../../components/astro/FaqSchema.astro'
import PrivacyComparisonTable from '../../components/astro/PrivacyComparisonTable.astro'

const title = 'Free Online QR Code Generator (PNG, SVG, Colors & WiFi) | Rocking Tools'
const description = 'Create custom high-resolution QR codes for URLs, Wi-Fi networks, vCards, text, and email. Custom colors, logo upload, and vector SVG download — 100% free and private.'
const keywords = 'qr code generator, free qr code maker, custom qr code, wifi qr code generator, vcard qr code, svg qr code, high res qr code, private qr generator'

const faqItems = [
  { q: 'Is my input data or generated QR code sent to any server?', a: 'No. All QR code matrix calculations, canvas rendering, and downloads take place 100% client-side inside your web browser.' },
  { q: 'Can I download vector SVG QR codes for professional print design?', a: 'Yes! You can export your QR code as scalable vector graphics (SVG) or high-resolution PNG/WebP images up to 1200px.' },
  { q: 'How do Wi-Fi QR codes work?', a: 'Scanning a Wi-Fi QR code with an iPhone or Android camera automatically prompts the device to join the network without typing the password.' },
  { q: 'What is Error Correction Level?', a: 'Error Correction adds redundancy so the QR code remains scannable even if partially obscured or damaged. Level H (30%) is recommended when adding center logos.' }
]
---

<BaseLayout title={title} description={description} path="/qr-code-generator" keywords={keywords}>
  <SoftwareApplicationSchema slot="head" name="Free Online QR Code Generator" description={description} path="/qr-code-generator" />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'QR Code Generator' }]} />

  <div class="tool-hero">
    <h1>Free Online QR Code Generator</h1>
    <p>Generate high-resolution PNG & vector SVG QR codes for websites, Wi-Fi, contacts, and text with custom colors.</p>
    <img
      src="/og/qr-code-generator.png"
      alt="Free Online QR Code Generator with PNG SVG and Wi-Fi mode preview"
      class="tool-preview-img"
      width="1200"
      height="630"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <QrCodeGenerator client:load />

  <article class="tool-guide">
    <h2>Client-Side QR Code Creation &amp; Customization Features</h2>
    <p>Generate scannable codes for any digital touchpoint with customizable aesthetics and zero tracking.</p>

    <h3>Specialized QR Code Generators</h3>
    <p>Create tailored QR codes for specific communication channels and devices:</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin-bottom: 24px;">
      <a href="/qr-code-generator/url" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">🌐</span><strong style="font-size: 14px; color: var(--ink);">Website URL QR</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Direct scans to websites, landing pages, social profiles, and YouTube links.</p>
      </a>
      <a href="/qr-code-generator/wifi" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">📶</span><strong style="font-size: 14px; color: var(--ink);">Wi-Fi Access QR</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Let guests scan to join WPA/WPA2/WPA3 Wi-Fi networks without typing passwords.</p>
      </a>
      <a href="/qr-code-generator/vcard" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">📇</span><strong style="font-size: 14px; color: var(--ink);">Digital vCard Contact</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Add complete address book contact info to smartphone address books in 1 tap.</p>
      </a>
      <a href="/qr-code-generator/sms" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">💬</span><strong style="font-size: 14px; color: var(--ink);">SMS & Phone Call</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Pre-fill SMS text messages or phone numbers for direct customer support.</p>
      </a>
      <a href="/qr-code-generator/email" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">✉️</span><strong style="font-size: 14px; color: var(--ink);">Email Draft QR</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Open user email app with pre-filled recipient address, subject, and body text.</p>
      </a>
      <a href="/qr-code-generator/text" style="display: flex; flex-direction: column; padding: 16px; background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; text-decoration: none; transition: all 150ms ease;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;"><span style="font-size: 18px;">📝</span><strong style="font-size: 14px; color: var(--ink);">Plain Text Notes</strong></div>
        <p style="font-size: 12.5px; color: var(--ink-dim); margin: 0; line-height: 1.5;">Encode serial codes, inventory IDs, and offline text messages.</p>
      </a>
    </div>

    <PrivacyComparisonTable toolName="QR Code Generation" competitorLabel="Other QR Generators" />

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentSlug="/qr-code-generator" />
</BaseLayout>

<style>
  .tool-hero { max-width: 900px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .tool-preview-img { width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 24px; display: block; object-fit: cover; }

  .tool-guide {
    max-width: 900px;
    margin: 40px auto;
    padding: 32px;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
  }
  .tool-guide h2 { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 12px; }
  .tool-guide h3 { font-size: 16px; font-weight: 700; color: var(--ink); margin-top: 24px; margin-bottom: 8px; }
  .tool-guide p, .tool-guide li { font-size: 14px; color: var(--ink-dim); line-height: 1.6; }
  .tool-guide ul { padding-left: 20px; margin-bottom: 24px; }
  .faq-item { margin-bottom: 16px; }
  .faq-item h4 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
  .faq-item p { margin: 0; }
</style>
