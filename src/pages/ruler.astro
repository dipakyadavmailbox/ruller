---
import MinimalLayout from '../layouts/MinimalLayout.astro'
import RulerApp from '../components/react/ruler/RulerApp.jsx'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import FaqSchema from '../components/astro/FaqSchema.astro'

const title = 'Online Screen Ruler — Actual Physical Size (mm, cm, in) | Rocking Tools'
const description = 'Free on-screen ruler calibrated to your actual display size. Measure physical objects in millimetres, centimetres, or inches with 100% accuracy.'
const keywords = 'online screen ruler, actual size ruler, mm ruler online, cm ruler, inch ruler on screen, calibrated screen ruler, measure on screen, real size ruler'

const faqItems = [
  { q: 'How do I calibrate the online screen ruler to actual physical size?', a: 'Click the Calibrate button in the toolbar and hold a standard physical credit card or driver license up to your monitor screen. Adjust the slider until the on-screen card guide matches your physical card exactly.' },
  { q: 'Why is standard screen ruler software inaccurate on modern monitors?', a: 'Standard web rulers assume all screens are 96 DPI. Modern 4K monitors, Retina displays, and laptops have pixel densities ranging from 120 DPI to 300+ DPI. Manual calibration guarantees 1:1 millimeter precision.' },
  { q: 'Is the screen ruler scale accurate when zooming in or out?', a: 'Yes! The ruler dynamically listens to browser viewport scale and device pixel ratio events to recalculate scale factors so your measurements remain physically true.' },
  { q: 'Can I use this screen ruler on a phone or tablet screen?', a: 'Yes! You can use it on iPhones, iPads, Android tablets, or desktop monitors. Just calibrate once using any standard ID or credit card.' },
  { q: 'Does this screen ruler record or upload my screen or camera?', a: 'No. The screen ruler renders 100% in CSS and SVG locally in your browser thread. No camera, screen recording, or server requests are involved.' }
]
---

<MinimalLayout title={title} description={description} path="/ruler" keywords={keywords}>
  <SoftwareApplicationSchema
    name="Online Screen Ruler"
    description={description}
    path="/ruler"
    slot="head"
  />
  <FaqSchema items={faqItems} slot="head" />

  <div class="hero">
    <div id="scale-badge" class="scale-badge">UNCALIBRATED SCALE · 96 DPI</div>
    <h1>Measure anything<br />on your screen.</h1>
    <p>
      Rulers pinned to the edges of the viewport at true millimetre / inch
      scale. Physically fixed even when you zoom your browser.
    </p>
  </div>

  <RulerApp client:only="react" />

  <div class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">
    <h2>Actual Size Online Screen Ruler Guide & Instructions</h2>
    <p>Use our free on-screen ruler to measure real-world items directly against your computer screen, tablet, or mobile phone in inches, centimeters, or millimeters. Calibrate using a standard credit card for 100% true physical accuracy.</p>
    
    <h3>How Screen Ruler Calibration Works</h3>
    <p>A standard ISO 7810 ID-1 credit card is exactly 85.60 mm wide (3.370 inches). By matching the on-screen card border to a physical card in your hand, our algorithm calculates your screen exact PPI (Pixels Per Inch) and scales the digital ruler ticks to match real physical dimensions.</p>

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div>
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </div>
</MinimalLayout>

<style>
  .hero {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 48px;
    pointer-events: none;
  }
  .scale-badge {
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(32px, 6vw, 64px);
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    max-width: 900px;
  }
  .hero p {
    margin-top: 20px;
    font-size: 15px;
    color: var(--ink-dim);
    max-width: 520px;
    line-height: 1.6;
  }
</style>

