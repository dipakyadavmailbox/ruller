---
import MinimalLayout from '../../layouts/MinimalLayout.astro'
import RulerApp from '../../components/react/ruler/RulerApp.jsx'
import SoftwareApplicationSchema from '../../components/astro/SoftwareApplicationSchema.astro'
import FaqSchema from '../../components/astro/FaqSchema.astro'
import PrivacyComparisonTable from '../../components/astro/PrivacyComparisonTable.astro'

const title = 'Online Screen Ruler — 1:1 Actual Size Calibrated | Rocking Tools'
const description = 'Actual size online screen ruler calibrated to your monitor using a credit card. Measure in inches, cm, and mm with 1:1 physical accuracy. Works on mobile, tablet, and 4K displays.'
const keywords = 'online screen ruler, actual size ruler, mm ruler online, cm ruler, inch ruler on screen, calibrated screen ruler, measure on screen, real size ruler'

const faqItems = [
  { q: 'How do I calibrate the online screen ruler to actual physical size?', a: 'Click the Calibrate button in the toolbar and hold a standard physical credit card or driver license up to your monitor screen. Adjust the slider until the on-screen card guide matches your physical card exactly.' },
  { q: 'Why is standard screen ruler software inaccurate on modern monitors?', a: 'Standard web rulers assume all screens are 96 DPI. Modern 4K monitors, Retina displays, and laptops have pixel densities ranging from 120 DPI to 300+ DPI. Manual calibration guarantees 1:1 millimeter precision.' },
  { q: 'Is the screen ruler scale accurate when zooming in or out?', a: 'Yes! The ruler dynamically listens to browser viewport scale and device pixel ratio events to recalculate scale factors so your measurements remain physically true.' },
  { q: 'Can I use this screen ruler on a phone or tablet screen?', a: 'Yes! You can use it on iPhones, iPads, Android tablets, or desktop monitors. Just calibrate once using any standard ID or credit card.' },
  { q: 'Does this screen ruler record or upload my screen or camera?', a: 'No. The screen ruler renders 100% in CSS and SVG locally in your browser thread. No camera, screen recording, or server requests are involved.' }
]
---

<MinimalLayout title={title} description={description} path="/ruler" keywords={keywords}>
  <SoftwareApplicationSchema
    name="Online Screen Ruler"
    description={description}
    path="/ruler"
    slot="head"
  />
  <FaqSchema items={faqItems} slot="head" />

  <section class="hero">
    <div id="scale-badge" class="scale-badge">UNCALIBRATED SCALE · 96 DPI</div>
    <h1>Measure anything<br />on your screen.</h1>
    <p>
      Rulers pinned to the edges of the viewport at true millimetre / inch
      scale. Physically fixed even when you zoom your browser — calibrate once
      with a credit card and every tick matches real life.
    </p>
    <a class="scroll-cue" href="#ruler-guide">
      How calibration works &nbsp;↓
    </a>
  </section>

  <RulerApp client:load />

  <article id="ruler-guide" class="ruler-guide">
    <h2>Online Screen Ruler — Calibration Guide &amp; Instructions</h2>
    <p>
      Use our free on-screen ruler to measure real-world items directly against your computer screen,
      tablet, or mobile phone in inches, centimeters, or millimeters. Calibrate once using a standard
      credit card for 100% true physical accuracy — no app install or server required.
    </p>

    <h3>How Screen Ruler Calibration Works</h3>
    <p>
      A standard ISO 7810 ID-1 credit card is exactly 85.60 mm wide (3.370 inches). By matching the
      on-screen card border to a physical card in your hand, our algorithm calculates your screen's
      exact PPI (Pixels Per Inch) and scales the ruler ticks to match real physical dimensions. The
      calibration value is saved in your browser's local storage so you only need to do it once per device.
    </p>

    <h3>Quick Start</h3>
    <ol>
      <li>Open the <strong>Controls</strong> panel and press <strong>Calibrate</strong>.</li>
      <li>Hold any bank card or ID flat against the screen and drag the slider until the outline matches its edges.</li>
      <li>Pick your unit — <strong>mm</strong>, <strong>cm</strong>, <strong>in</strong>, or <strong>px</strong> — and choose which edges show a ruler.</li>
      <li>Click a ruler edge to drop an alignment guide, or press <strong>M</strong> to measure a distance between two points.</li>
    </ol>

    <h3>Why Most Online Rulers Are Inaccurate</h3>
    <p>
      Standard web rulers assume all screens are 96 DPI — a value that was accurate for CRT monitors
      in the 1990s but is wrong for virtually every modern display. Retina MacBooks run at 220+ DPI,
      4K monitors range from 140–200 DPI, and mobile phones often exceed 400 DPI. Without manual
      calibration, a "10 cm" ruler on screen can be off by 40–60% from real-world size.
    </p>

    <h3>Keyboard Shortcuts</h3>
    <ul class="shortcut-list">
      <li><kbd>G</kbd> Toggle guides</li>
      <li><kbd>M</kbd> Measure mode</li>
      <li><kbd>C</kbd> Clear all guides</li>
      <li><kbd>Esc</kbd> Cancel / exit measure mode</li>
    </ul>

    <h3>Dedicated Ruler Scales &amp; Calibration Views</h3>
    <ul>
      <li><a href="/ruler/cm-ruler"><strong>Centimeter (cm) Ruler:</strong> Actual-size metric ruler with mm subdivisions — ideal for measuring everyday objects in centimeters.</a></li>
      <li><a href="/ruler/inch-ruler"><strong>Inch (in) Ruler:</strong> 1:1 real-scale imperial ruler with 1/8 and 1/16 inch fractional subdivisions for precision work.</a></li>
      <li><a href="/ruler/mm-ruler"><strong>Millimeter (mm) Precision Ruler:</strong> High-precision engineering and electronics measurement with fine tick marks.</a></li>
      <li><a href="/ruler/credit-card-calibration"><strong>Credit Card Calibration Guide:</strong> Step-by-step calibration walkthrough using any standard ISO bank card or ID card.</a></li>
    </ul>

    <PrivacyComparisonTable toolName="Screen Ruler Calibration" competitorLabel="Other Ruler Apps" />

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}

    <p class="back-link"><a href="/">← Back to all tools</a></p>
  </article>
</MinimalLayout>

<style is:global>
  /*
   * MinimalLayout locks <body> to overflow:hidden for the full-bleed app
   * view. This page carries a visible guide article below the ruler, so it
   * must be able to scroll to it.
   */
  body {
    overflow-y: auto !important;
  }
  html {
    scroll-behavior: smooth;
    /* keep anchored headings clear of the fixed 44px top ruler */
    scroll-padding-top: 60px;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>

<style>
  /* ── Hero: a full first screen, in normal flow (not an overlay) ── */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 96px 32px 72px;
    pointer-events: none;
  }
  .scale-badge {
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 3px;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(30px, 5.5vw, 60px);
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    max-width: 900px;
  }
  .hero p {
    margin-top: 20px;
    font-size: 15px;
    color: var(--ink-dim);
    max-width: 540px;
    line-height: 1.6;
  }
  .scroll-cue {
    pointer-events: auto;
    margin-top: 40px;
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--accent);
    background: var(--accent-light);
    border: 1px solid var(--panel-border);
    border-radius: 999px;
    text-decoration: none;
    transition: transform 120ms ease, background 120ms ease;
  }
  .scroll-cue:hover {
    transform: translateY(2px);
    background: var(--accent-light);
  }

  /* On smaller screens the control panel covers most of the top-left, so
     drop the hero copy clear of it instead of centring under it. */
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      justify-content: flex-start;
      padding: 620px 20px 72px;
      text-align: center;
    }
    .hero h1 { font-size: clamp(28px, 8vw, 44px); }
  }

  /* ── Guide article below the ruler ──
     Sits above the fixed control panel / rulers (z-index 100) with an opaque
     background, so scrolling into the guide gives a clean, unobstructed read.
     The panel stays fully usable up in the hero. */
  .ruler-guide {
    position: relative;
    z-index: 101;
    max-width: 820px;
    margin: 0 auto 80px;
    padding: 40px clamp(20px, 5vw, 40px);
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.25);
  }
  @media (max-width: 900px) {
    .ruler-guide {
      margin-left: 12px;
      margin-right: 12px;
    }
  }
  .ruler-guide h2 {
    font-size: clamp(19px, 3vw, 24px); font-weight: 800; color: var(--ink);
    margin: 0 0 12px;
  }
  .ruler-guide h3 {
    font-size: 16px; font-weight: 700; color: var(--ink);
    margin-top: 28px; margin-bottom: 8px;
  }
  .ruler-guide p, .ruler-guide li {
    font-size: 14px; color: var(--ink-dim); line-height: 1.7;
  }
  .ruler-guide ul, .ruler-guide ol {
    padding-left: 22px; margin-bottom: 16px;
  }
  .ruler-guide li { margin-bottom: 8px; }
  .ruler-guide a { color: var(--accent); text-decoration: none; }
  .ruler-guide a:hover { text-decoration: underline; }

  .shortcut-list {
    list-style: none; padding-left: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 8px;
  }
  .shortcut-list li { margin-bottom: 0; }
  .ruler-guide kbd {
    display: inline-block;
    min-width: 22px;
    padding: 2px 7px;
    margin-right: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: center;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-bottom-width: 2px;
    border-radius: 6px;
  }

  .faq-item { margin-bottom: 16px; }
  .faq-item h4 {
    font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 4px;
  }
  .faq-item p { margin: 0; }

  .back-link { margin-top: 32px; }
  .back-link a { font-weight: 700; }
</style>
