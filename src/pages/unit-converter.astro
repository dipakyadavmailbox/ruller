---
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/astro/Breadcrumb.astro'
import RelatedTools from '../components/astro/RelatedTools.astro'
import SoftwareApplicationSchema from '../components/astro/SoftwareApplicationSchema.astro'
import FaqSchema from '../components/astro/FaqSchema.astro'
import UnitConverter from '../components/react/unitconverter/UnitConverter.jsx'

const title = 'Unit Converter — Length, Weight, Temperature & 7 More | Rocking Tools'
const description =
  'Free multi-category unit converter. Convert between metric & imperial units instantly: Length, Weight, Temperature, Area, Volume, Speed, Time, Data Storage, Energy, and Pressure. 100% private in browser.'
const keywords =
  'unit converter, length converter, weight converter, temperature converter, area converter, volume converter, speed converter, data storage converter, energy converter, pressure converter, km to miles, celsius to fahrenheit, lbs to kg, MB to GB, metric converter'

const faqItems = [
  {
    q: 'How many unit categories are supported?',
    a: '10 categories covering over 80 individual units: Length, Weight/Mass, Temperature, Area, Volume, Speed, Time, Data Storage, Energy, and Pressure.',
  },
  {
    q: 'How accurate are the conversions?',
    a: 'All conversions use IEEE 754 double-precision floating point arithmetic with up to 15 significant digits internally. Results are displayed with up to 10 significant figures for readability.',
  },
  {
    q: 'Does the tool work offline?',
    a: 'Yes. All conversion math runs locally in your browser using JavaScript. Once the page is loaded, no internet connection is needed.',
  },
  {
    q: 'How does temperature conversion work differently?',
    a: 'Temperature uses direct formulas (not multiplication factors). All values are converted through Celsius as an intermediate step — for example, to convert Fahrenheit to Kelvin, the tool converts F → C → K.',
  },
  {
    q: 'Can I enter values in both the From and To fields?',
    a: 'Yes. Either field is fully editable. Changing the "From" field updates "To", and changing the "To" field back-calculates the "From" value. The ⇄ Swap button also reverses both unit selectors instantly.',
  },
]
---

<BaseLayout title={title} description={description} path="/unit-converter" keywords={keywords}>
  <SoftwareApplicationSchema
    slot="head"
    name="Universal Unit Converter"
    description={description}
    path="/unit-converter"
  />
  <FaqSchema slot="head" items={faqItems} />

  <Breadcrumb items={[{ label: 'Home', path: '/' }, { label: 'Unit Converter' }]} />

  <div class="tool-hero">
    <h1>Universal Unit Converter</h1>
    <p>
      Convert between metric &amp; imperial units across 10 categories — Length, Weight,
      Temperature, Area, Volume, Speed, Time, Data, Energy, and Pressure. Free, instant, and 100%
      private.
    </p>
    <img
      src="/og/unit-converter.png"
      alt="Unit Converter tool interface preview"
      class="tool-preview-img"
      width="1200"
      height="630"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <UnitConverter client:load />

  <article class="tool-guide">
    <h2>Precision Unit Conversion for Every Use Case</h2>
    <p>
      Whether you're a student, engineer, chef, developer, or traveler, precise unit
      conversions are critical. Rocking Tools' Unit Converter runs entirely in your browser
      with no tracking, no sign-up, and no wait times.
    </p>

    <h3>Supported Categories</h3>
    <ul>
      <li><strong>Length:</strong> Metric (km, m, cm, mm, μm), Imperial (mi, yd, ft, in), nautical mile, light year</li>
      <li><strong>Weight / Mass:</strong> Metric ton, kilogram, gram, milligram, pound, ounce, stone</li>
      <li><strong>Temperature:</strong> Celsius, Fahrenheit, Kelvin, Rankine — via direct formulas</li>
      <li><strong>Area:</strong> Square units from mm² to mi², hectares, acres</li>
      <li><strong>Volume:</strong> Metric (m³, L, mL) + US culinary (gallon, quart, pint, cup, fl oz, tbsp, tsp)</li>
      <li><strong>Speed:</strong> m/s, km/h, mph, knots, ft/s, Mach</li>
      <li><strong>Time:</strong> Nanoseconds to years — 10 units</li>
      <li><strong>Data Storage:</strong> Bit, byte, KB, MB, GB, TB, PB (binary 1024-based)</li>
      <li><strong>Energy:</strong> Joule, kJ, calorie, kcal, Wh, kWh, BTU, foot-pound, electron volt</li>
      <li><strong>Pressure:</strong> Pascal, kPa, bar, PSI, atmosphere, Torr, inHg</li>
    </ul>

    <h3>How the Conversion Works</h3>
    <p>
      All factor-based categories (every category except Temperature) use a <strong>base unit</strong> approach:
      the input value is multiplied by the "from unit" factor to reach the base unit, then divided by
      the "to unit" factor. This single formula handles all combinations correctly.
    </p>
    <p>
      Temperature uses dedicated formulas with Celsius as the intermediate step,
      ensuring accuracy across all four temperature scales.
    </p>

    <h3>Frequently Asked Questions</h3>
    {faqItems.map((faq) => (
      <div class="faq-item">
        <h4>{faq.q}</h4>
        <p>{faq.a}</p>
      </div>
    ))}
  </article>

  <RelatedTools currentSlug="/unit-converter" />
</BaseLayout>

<style>
  .tool-hero { max-width: 900px; margin: 0 auto; padding: 32px 20px 0; }
  .tool-hero h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
  .tool-hero p { color: var(--ink-dim); font-size: 14px; line-height: 1.6; margin-bottom: 16px; }
  .tool-preview-img { width: 100%; height: auto; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 24px; display: block; object-fit: cover; }

  .tool-guide {
    max-width: 900px; margin: 40px auto; padding: 32px;
    background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 16px;
  }
  .tool-guide h2 { font-size: 20px; font-weight: 800; color: var(--ink); margin-bottom: 12px; }
  .tool-guide h3 { font-size: 16px; font-weight: 700; color: var(--ink); margin-top: 24px; margin-bottom: 8px; }
  .tool-guide p, .tool-guide li { font-size: 14px; color: var(--ink-dim); line-height: 1.65; }
  .tool-guide ul { padding-left: 20px; margin-bottom: 16px; }
  .tool-guide li { margin-bottom: 6px; }
  .faq-item { margin-bottom: 16px; }
  .faq-item h4 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
  .faq-item p { margin: 0; }
</style>
