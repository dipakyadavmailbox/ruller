---
import BaseLayout from '../layouts/BaseLayout.astro'
import Workspace from '../components/react/workspace/Workspace.jsx'

const title = 'Tool Workspace — All-in-One Browser Utility Suite | Rocking Tools'
const description =
  'Your unified workspace for all Rocking Tools. Drop any file for instant auto-detection and tool suggestions. Pin favorites, search with ⌘K, and track recent files — 100% private, nothing uploaded.'
const keywords =
  'online tool workspace, browser utility suite, drag drop file tools, pdf tool dashboard, image tool online, developer tools workspace, all in one browser tools'
---

<BaseLayout title={title} description={description} path="/workspace" keywords={keywords}>
  <Workspace client:only="react" />
</BaseLayout>
