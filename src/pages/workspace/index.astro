---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Workspace from '../../components/react/workspace/Workspace.jsx'

const title = 'All-in-One Online Tool Workspace | Rocking Tools'
const description = 'Access all studio-grade browser utilities in a single drag-and-drop workspace dashboard. 100% private, client-side, zero file upload.'
const keywords =
  'online tool workspace, browser utility suite, drag drop file tools, pdf tool dashboard, image tool online, developer tools workspace, all in one browser tools'
---

<BaseLayout title={title} description={description} path="/workspace" keywords={keywords}>
  <Workspace client:load />
</BaseLayout>
